{"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"metadata":{"title":"Customization","modules":[{"name":"Adyen"}],"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Localization","text":"Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To customize strings, see: "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Styling","text":"Styling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"syntax":"swift","type":"codeListing","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"]}]},{"title":"Components","content":[{"type":"codeListing","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"syntax":"swift"}]}]},{"type":"heading","level":2,"anchor":"Custom-Payment-Method-Display-Information","text":"Custom Payment Method Display Information"},{"type":"paragraph","inlineContent":[{"text":"The following examples provide custom information to show for a specific payment method","type":"text"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"syntax":"swift","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"type":"codeListing"},{"syntax":"swift","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}],"type":"paragraph"},{"syntax":"swift","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"type":"codeListing"}]},{"title":"Components","content":[{"type":"paragraph","inlineContent":[{"text":"For components you can either set the ","type":"text"},{"code":"merchantProvidedDisplayInformation","type":"codeVoice"},{"text":" directly before creating the component or use the same approach as with ","type":"text"},{"inlineContent":[{"type":"text","text":"Drop-In"}],"type":"strong"},{"text":".","type":"text"}]},{"type":"codeListing","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"syntax":"swift"}]}]},{"type":"paragraph","inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}],"sections":[],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"references":{"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}],"role":"article","kind":"article","title":"API Reference","type":"topic","url":"\/documentation\/adyen\/api-reference"},"doc://adyen.Adyen/documentation/Adyen":{"title":"Adyen","kind":"symbol","type":"topic","abstract":[],"url":"\/documentation\/adyen","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","role":"collection"},"doc://adyen.Adyen/documentation/Adyen/Localization":{"type":"topic","url":"\/documentation\/adyen\/localization","kind":"article","title":"Localization","abstract":[{"type":"text","text":"The SDK allows you to customize UI strings and manage locale behavior using the "},{"code":"LocalizationParameters","type":"codeVoice"},{"type":"text","text":" object. You can configure these settings for both the Drop-in and individual Components through their "},{"code":"configuration.localizationParameters","type":"codeVoice"},{"type":"text","text":" property."}],"identifier":"doc:\/\/adyen.Adyen\