"text":"AdyenContext","kind":"identifier"}],"abstract":[{"type":"text","text":"A class that defines the behavior of the components in a payment flow."}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},"AdvancedFlow.md":{"type":"link","identifier":"AdvancedFlow.md","title":"Advanced Flow","titleInlineContent":[{"type":"text","text":"Advanced Flow"}],"url":"AdvancedFlow.md"},"doc://adyen.Adyen/documentation/Adyen":{"abstract":[],"title":"Adyen","role":"collection","url":"\/documentation\/adyen","kind":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","type":"topic"},"doc://adyen.Adyen/documentation/Adyen/RedirectComponent":{"title":"RedirectComponent","kind":"symbol","abstract":[{"type":"text","text":"Handles any redirect Url whether its a web url, an App custom scheme url, or an app universal link."}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent","role":"symbol","type":"topic","url":"\/documentation\/adyen\/redirectcomponent","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedirectComponent"}],"navigatorTitle":[{"kind":"identifier","text":"RedirectComponent"}]},"doc://adyen.Adyen/documentation/Adyen/DokuComponent":{"kind":"symbol","url":"\/documentation\/adyen\/dokucomponent","type":"topic","title":"DokuComponent","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DokuComponent","kind":"identifier"}],"navigatorTitle":[{"text":"DokuComponent","kind":"identifier"}],"abstract":[{"type":"text","text":"A component that provides a form for Doku Wallet, Doku Alfamart, and Doku Indomaret  payments."}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","role":"symbol"}}}