{"kind":"article","metadata":{"role":"article","modules":[{"name":"Adyen"}],"roleHeading":"Article","title":"DropIn"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/dropin"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropIn"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the simplified checkout flow with the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to "},{"type":"reference","identifier":"AdvancedFlow.md","isActive":true},{"type":"text","text":"."}]},{"type":"heading","text":"Setting up the Drop-in","level":2,"anchor":"Setting-up-the-Drop-in"},{"type":"paragraph","inlineContent":[{"text":"All Components need an ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","type":"reference","isActive":true},{"text":". An instance of ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","type":"reference","isActive":true},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"text":" ","type":"text"},{"text":"Please read more ","type":"text"},{"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","type":"reference","isActive":true},{"text":" about the client key and how to get one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"Environment.test","type":"codeVoice"},{"text":" during testing. When you’re ready to accept live payments, change the value to one of our ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Environment","overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"isActive":true,"overridingTitle":"live environments","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"We recommend creating a new context for each payment attempt.","type":"text"}]},{"type":"codeListing","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"AdyenSession.Configuration"},{"type":"text","text":" with the response you received from the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" call and the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},{"type":"text","text":" instance."}]},{"type":"codeListing","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Call the static ","type":"text"},{"code":"initialize","type":"codeVoice"},{"text":" function of the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance.","type":"text"}]},{"type":"codeListing","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Create a configuration object for ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","isActive":true,"type":"reference"},{"text":". Check specific payment method pages to confirm if you need to include additional required parameters.","type":"text"}]},{"type":"codeListing","code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some payment methods need additional configuration. For example "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","isActive":true,"type":"reference"},{"type":"text","text":". These payment method specific configuration parameters can be set in an instance of "},{"code":"DropInComponent.Configuration","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Also for voucher payment methods like Doku variants, in order for the "},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","type":"reference"},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"code":"NSPhotoLibraryAddUsageDescription","type":"codeVoice"},{"text":" key in the application ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Presenting the Drop-in","level":2,"anchor":"Presenting-the-Drop-in"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent"},{"type":"text","text":" class and set the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" instance as the "},{"type":"codeVoice","code":"delegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"partialPaymentDelegate"},{"type":"text","text":" (if needed) of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent"},{"type":"text","text":" instance."}]},{"type":"codeListing","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""],"syntax":"swift"},{"type":"heading","text":"Implementing `AdyenSessionDelegate`","level":3,"anchor":"Implementing-AdyenSessionDelegate"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true,"type":"reference"},{"text":". To handle the results of the Drop-in, the following methods of ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true,"type":"reference"},{"text":" should be implemented:","type":"text"}]},{"type":"thematicBreak"},{"type":"codeListing","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling ","type":"text"},{"type":"codeVoice","code":"finalizeIfNeeded"},{"text":" on the component.","type":"text"}]},{"type":"thematicBreak"},{"type":"codeListing","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is invoked when an error occurred during the use of the Drop-in or the components."},{"type":"text","text":" "},{"type":"text","text":"You can then call the "},{"type":"codeVoice","code":"finalizeIfNeeded"},{"type":"text","text":" on the component, dismiss the component’s view controller in the completion callback and display an error message."}]},{"type":"thematicBreak"},{"type":"codeListing","code":["func didOpenExternalApplication(component: DropInComponent)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This optional method is invoked after a redirect to an external application has occurred.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","text":"Handling an action","level":2,"anchor":"Handling-an-action"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":"."}]},{"type":"heading","text":"Receiving redirect","level":3,"anchor":"Receiving-redirect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent","isActive":true},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":":"}]},{"type":"codeListing","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"],"syntax":"swift"}],"kind":"content"}],"abstract":[{"text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the ","type":"text"},{"type":"codeVoice","code":"\/sessions"},{"text":" response, and handles the entire checkout flow under the hood for most of use cases.","type":"text"}],"references":{"doc://adyen.Adyen/documentation/Adyen/AdyenSessionDelegate":{"navigatorTitle":[{"kind":"identifier","text":"AdyenSessionDelegate"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdyenSessionDelegate"}],"type":"topic","url":"\/documentation\/adyen\/adyensessiondelegate","role":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","abstract":[{"text":"Describes the methods a delegate of ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"text":" needs to implement.","type":"text"}],"title":"AdyenSessionDelegate"},"doc://adyen.Adyen/documentation/Adyen/DropInComponent":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DropInComponent"}],"abstract":[{"text":"A component that handles the entire flow of payment selection and payment details entry.","type":"text"}],"title":"DropInComponent","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DropInComponent"}],"url":"\/documentation\/adyen\/dropincomponent","type":"topic","role":"symbol"},"https://docs.adyen.com/development-resources/client-side-authentication":{"titleInlineContent":[{"type":"text","text":"here"}],"type":"link","title":"here","url":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"},"doc://adyen.Adyen/documentation/Adyen/ApplePayComponent":{"navigatorTitle":[{"text":"ApplePayComponent","kind":"identifier"}],"title":"ApplePayComponent","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ApplePayComponent","kind":"identifier"}],"abstract":[{"text":"A component that handles Apple Pay payments.","type":"text"}],"url":"\/documentation\/adyen\/applepaycomponent"},"doc://adyen.Adyen/documentation/Adyen/Environment":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Environment","navigatorTitle":[{"text":"Environment","kind":"identifier"}],"type":"topic","url":"\/documentation\/adyen\/environment","role":"symbol","abstract":[{"type":"text","text":"Struct that defines the environment to retrieve resources from."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}],"kind":"symbol","title":"Environment"},"doc://adyen.Adyen/documentation/Adyen/DokuComponent":{"navigatorTitle":[{"kind":"identifier","text":"DokuComponent"}],"title":"DokuComponent","type":"topic","abstract":[{"type":"text","text":"A component that provides a form for Doku Wallet, Doku Alfamart, and Doku Indomaret  payments."}],"url":"\/documentation\/adyen\/dokucomponent","role":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DokuComponent"}]},"doc://adyen.Adyen/documentation/Adyen/AdyenSession":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","title":"AdyenSession","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenSession","kind":"identifier"}],"abstract":[{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":" acts as the delegate for the checkout payment flow."},{"type":"text","text":" "},{"type":"text","text":"It can handle the required steps internally such as "},{"type":"codeVoice","code":"\/payments"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/payment\/details"},{"type":"text","text":" "},{"type":"text","text":"calls and partial payment calls, then provide feedback"},{"type":"text","text":" "},{"type":"text","text":"via "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true},{"type":"text","text":" methods."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"AdyenSession","kind":"identifier"}],"url":"\/documentation\/adyen\/adyensession","type":"topic"},"doc://adyen.Adyen/documentation/Adyen/RedirectComponent":{"kind":"symbol","abstract":[{"type":"text","text":"Handles any redirect Url whether its a web url, an App custom scheme url, or an app universal link."}],"url":"\/documentation\/adyen\/redirectcomponent","role":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent","title":"RedirectComponent","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedirectComponent"}],"navigatorTitle":[{"kind":"identifier","text":"RedirectComponent"}],"type":"topic"},"doc://adyen.Adyen/documentation/Adyen":{"url":"\/documentation\/adyen","type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","abstract":[],"title":"Adyen","kind":"symbol","role":"collection"},"doc://adyen.Adyen/documentation/Adyen/AdyenContext":{"navigatorTitle":[{"kind":"identifier","text":"AdyenContext"}],"url":"\/documentation\/adyen\/adyencontext","title":"AdyenContext","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdyenContext"}],"abstract":[{"text":"A class that defines the behavior of the components in a payment flow.","type":"text"}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","role":"symbol","type":"topic"},"AdvancedFlow.md":{"type":"link","title":"Advanced Flow","titleInlineContent":[{"type":"text","text":"Advanced Flow"}],"identifier":"AdvancedFlow.md","url":"AdvancedFlow.md"}}}