{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Localization","anchor":"Localization","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To customize strings, see: "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"heading","text":"Styling","anchor":"Styling","level":2},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"tabs":[{"content":[{"code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"type":"codeListing","syntax":"swift"}],"title":"Drop-in"},{"content":[{"code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"syntax":"swift","type":"codeListing"}],"title":"Components"}],"type":"tabNavigator"},{"type":"heading","text":"Custom Payment Method Display Information","anchor":"Custom-Payment-Method-Display-Information","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following examples provide custom information to show for a specific payment method"}]},{"tabs":[{"title":"Drop-in","content":[{"code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To override the display information for stored payment methods use:","type":"text"}]},{"code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"type":"codeListing","syntax":"swift"}]},{"title":"Components","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For components you can either set the "},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"type":"strong","inlineContent":[{"type":"text","text":"Drop-In"}]},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"]}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a full list of customization options can be found in the "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","variants":[{"paths":["\/documentation\/adyen\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"metadata":{"modules":[{"name":"Adyen"}],"roleHeading":"Article","title":"Customization","role":"article"},"references":{"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","type":"topic","role":"article","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}],"title":"API Reference","kind":"article","url":"\/documentation\/adyen\/api-reference"},"doc://adyen.Adyen/documentation/Adyen":{"url":"\/documentation\/adyen","type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","abstract":[],"title":"Adyen","kind":"symbol","role":"collection"},"doc://adyen.Adyen/documentation/Adyen/Localization":{"abstract":[{"type":"text","text":"The SDK allows you to customize UI strings and manage locale behavior using the "},{"code":"LocalizationParameters","type":"codeVoice"},{"type":"text","text":" object. You can configure these settings for both the Drop-in and individual Components through their "},{"code":"configuration.localizationParameters","type":"codeVoice"},{"type":"text","text":" property."}],"title":"Localization","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","url":"\/documentation\/adyen\/localization","type":"topic","role":"article","kind":"article"}}}