{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization"},"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"primaryContentSections":[{"content":[{"anchor":"Localization","level":2,"type":"heading","text":"Localization"},{"type":"paragraph","inlineContent":[{"text":"To customize strings, see: ","type":"text"},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","isActive":true},{"text":".","type":"text"}]},{"anchor":"Styling","level":2,"type":"heading","text":"Styling"},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"tabs":[{"title":"Drop-in","content":[{"code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"type":"codeListing","syntax":"swift"}]},{"title":"Components","content":[{"type":"codeListing","syntax":"swift","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"]}]}],"type":"tabNavigator"},{"anchor":"Custom-Payment-Method-Display-Information","level":2,"type":"heading","text":"Custom Payment Method Display Information"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following examples provide custom information to show for a specific payment method"}]},{"tabs":[{"title":"Drop-in","content":[{"type":"codeListing","syntax":"swift","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"]},{"type":"codeListing","syntax":"swift","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"]},{"type":"paragraph","inlineContent":[{"text":"To override the display information for stored payment methods use:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"]}]},{"title":"Components","content":[{"inlineContent":[{"text":"For components you can either set the ","type":"text"},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"text":" directly before creating the component or use the same approach as with ","type":"text"},{"inlineContent":[{"type":"text","text":"Drop-In"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"type":"codeListing"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","isActive":true},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"kind":"article","metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Adyen"}],"title":"Customization"},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://adyen.Adyen/documentation/Adyen/Localization":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","role":"article","title":"Localization","url":"\/documentation\/adyen\/localization","type":"topic","kind":"article","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"code":"LocalizationParameters","type":"codeVoice"},{"text":" object. You can configure these settings for both the Drop-in and individual Components through their ","type":"text"},{"code":"configuration.localizationParameters","type":"codeVoice"},{"text":" property.","type":"text"}]},"doc://adyen.Adyen/documentation/Adyen":{"url":"\/documentation\/adyen","title":"Adyen","type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","abstract":[],"kind":"symbol","role":"collection"},"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"role":"article","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}],"title":"API Reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","url":"\/documentation\/