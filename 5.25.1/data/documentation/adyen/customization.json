{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","roleHeading":"Article","title":"Customization","modules":[{"name":"Adyen"}]},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Localization","anchor":"Localization"},{"inlineContent":[{"text":"To customize strings, see: ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Styling","anchor":"Styling"},{"inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}],"type":"paragraph"},{"tabs":[{"content":[{"type":"codeListing","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"syntax":"swift"}],"title":"Drop-in"},{"content":[{"code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"type":"codeListing","syntax":"swift"}],"title":"Components"}],"type":"tabNavigator"},{"level":2,"type":"heading","text":"Custom Payment Method Display Information","anchor":"Custom-Payment-Method-Display-Information"},{"inlineContent":[{"text":"The following examples provide custom information to show for a specific payment method","type":"text"}],"type":"paragraph"},{"tabs":[{"content":[{"syntax":"swift","type":"codeListing","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"]},{"syntax":"swift","type":"codeListing","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}]},{"syntax":"swift","type":"codeListing","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"]}],"title":"Drop-in"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For components you can either set the "},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"inlineContent":[{"type":"text","text":"Drop-In"}],"type":"strong"},{"type":"text","text":"."}]},{"type":"codeListing","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"syntax":"swift"}],"title":"Components"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"For a full list of customization options can be found in the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","type":"topic","role":"article","url":"\/documentation\/adyen\/api-reference","title":"API Reference","kind":"article","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}]},"doc://adyen.Adyen/documentation/Adyen":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","type":"topic","title":"Adyen","url":"\/documentation\/adyen","kind":"symbol","role":"collection","abstract":[]},"doc://adyen.Adyen/documentation/Adyen/Localization":{"kind":"article","url":"\/documentation\/adyen\/localization","abstract":[{"type":"text","text":"The SDK allows you to customize UI strings and manage locale behavior using the "},{"code":"LocalizationParameters","type":"codeVoice"},{"text":" object. You can configure these settings for both the Drop-in and individual Components through their ","type":"text"},{"type":"codeVoice","code":"configuration.localizationParameters"},{"text":" property.","type":"text"}],"type":"topic","title":"Localization","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","role":"article"}}}