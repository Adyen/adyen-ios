{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"The issuer number of the highest scheme you listed under "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"type":"text","text":" "},{"type":"text","text":"The value is clamped between 0 and 39."}],"kind":"symbol","metadata":{"modules":[{"name":"Adyen"}],"roleHeading":"Instance Property","symbolKind":"property","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"externalID":"s:5Adyen0A15ActionComponentC13ConfigurationV5TwintV15maxIssuerNumberSivp","title":"maxIssuerNumber"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"platforms":["iOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed."},{"type":"text","text":" "},{"type":"text","text":"For this to work, "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":" must include “twint-extended”."},{"type":"text","text":" "},{"type":"text","text":"If you configure any "},{"type":"codeVoice","code":"maxIssuerNumber"},{"type":"text","text":" below 39, the result will always contain all apps above "},{"type":"codeVoice","code":"maxIssuerNumber"},{"type":"te