{"kind":"article","metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Adyen"}],"title":"DropIn"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the simplified checkout flow with the "},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to "},{"identifier":"AdvancedFlow.md","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Setting-up-the-Drop-in","level":2,"text":"Setting up the Drop-in"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All Components need an "},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","type":"reference"},{"text":". An instance of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Please read more "},{"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","type":"reference","isActive":true},{"type":"text","text":" about the client key and how to get one."}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"Environment.test","type":"codeVoice"},{"text":" during testing. When you’re ready to accept live payments, change the value to one of our ","type":"text"},{"isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","overridingTitle":"live environments","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"We recommend creating a new context for each payment attempt."}]},{"type":"codeListing","syntax":"swift","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"]},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"text":" with the response you received from the ","type":"text"},{"type":"codeVoice","code":"\/sessions"},{"text":" call and the ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","type":"reference","isActive":true},{"type":"text","text":" instance."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call the static "},{"type":"codeVoice","code":"initialize"},{"type":"text","text":" function of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance.","type":"text"}]},{"type":"codeListing","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a configuration object for "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}]},{"code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Some payment methods need additional configuration. For example "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent"},{"text":". These payment method specific configuration parameters can be set in an instance of ","type":"text"},{"type":"codeVoice","code":"DropInComponent.Configuration"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Also for voucher payment methods like Doku variants, in order for the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","isActive":true},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"code":"NSPhotoLibraryAddUsageDescription","type":"codeVoice"},{"text":" key in the application ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Presenting-the-Drop-in","level":2,"text":"Presenting the Drop-in"},{"inlineContent":[{"text":"Initialize the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"type":"text","text":" class and set the "},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"type":"text","text":" instance as the "},{"code":"delegate","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"partialPaymentDelegate"},{"type":"text","text":" (if needed) of the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"type":"text","text":" instance."}],"type":"paragraph"},{"code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""],"syntax":"swift","type":"codeListing"},{"anchor":"Implementing-AdyenSessionDelegate","type":"heading","level":3,"text":"Implementing `AdyenSessionDelegate`"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true},{"text":". To handle the results of the Drop-in, the following methods of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"type":"text","text":" should be implemented:"}]},{"code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling "},{"code":"finalizeIfNeeded","type":"codeVoice"},{"type":"text","text":" on the component."}]},{"type":"codeListing","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"This method is invoked when an error occurred during the use of the Drop-in or the components."},{"text":" ","type":"text"},{"type":"text","text":"You can then call the "},{"type":"codeVoice","code":"finalizeIfNeeded"},{"text":" on the component, dismiss the component’s view controller in the completion callback and display an error message.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["func didOpenExternalApplication(component: DropInComponent)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}]},{"anchor":"Handling-an-action","text":"Handling an action","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":"."}]},{"anchor":"Receiving-redirect","text":"Receiving redirect","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent","isActive":true},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"]}]}],"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/DropIn","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" response, and handles the entire checkout flow under the hood for most of use cases."}],"variants":[{"paths":["\/documentation\/adyen\/dropin"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Adyen/documentation/Adyen/Environment":{"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}],"abstract":[{"text":"Struct that defines the environment to retrieve resources from.","type":"text"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","role"