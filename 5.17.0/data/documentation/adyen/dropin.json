ments"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"\/payment\/details"},{"type":"text","text":" "},{"type":"text","text":"calls and partial payment calls, then provide feedback"},{"type":"text","text":" "},{"type":"text","text":"via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"type":"text","text":" methods."}],"url":"\/documentation\/adyen\/adyensession","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"AdyenSession","kind":"identifier"}],"role":"symbol","type":"topic","navigatorTitle":[{"text":"AdyenSession","kind":"identifier"}],"title":"AdyenSession"},"doc://Adyen/documentation/Adyen/AdyenSessionDelegate":{"kind":"symbol","abstract":[{"type":"text","text":"Describes the methods a delegate of "},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"text":" needs to implement.","type":"text"}],"url":"\/documentation\/adyen\/adyensessiondelegate","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AdyenSessionDelegate"}],"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AdyenSessionDelegate"}],"title":"AdyenSessionDelegate"}}}