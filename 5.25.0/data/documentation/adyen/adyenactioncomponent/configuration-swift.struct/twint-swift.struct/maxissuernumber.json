{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The issuer number of the highest scheme you listed under ","type":"text"},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”.","type":"text"},{"text":" ","type":"text"},{"text":"The value is clamped between 0 and 39.","type":"text"}],"metadata":{"externalID":"s:5Adyen0A15ActionComponentC13ConfigurationV5TwintV15maxIssuerNumberSivp","modules":[{"name":"Adyen"}],"title":"maxIssuerNumber","roleHeading":"Instance Property","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxIssuerNumber","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/adyenactioncomponent\/configuration-swift.struct\/twint-swift.struct\/maxissuernumber"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxIssuerNumber","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["iOS"]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed."},{"type":"text","text":" "},{"type":"text","text":"For this to work, "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":" must include “twint-extended”."},{"type":"text","text":" "},{"type":"text","text":"If you configure any "},{"type":"codeVoice","code":"maxIssuerNumb