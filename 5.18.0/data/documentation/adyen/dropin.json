n/RedirectComponent":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"RedirectComponent"}],"title":"RedirectComponent","url":"\/documentation\/adyen\/redirectcomponent","abstract":[{"text":"Handles any redirect Url whether its a web url, an App custom scheme url, or an app universal link.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RedirectComponent","kind":"identifier"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent"},"doc://Adyen/documentation/Adyen/Environment":{"navigatorTitle":[{"text":"Environment","kind":"identifier"}],"type":"topic","title":"Environment","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Environment","kind":"identifier"}],"abstract":[{"type":"text","text":"Struct that defines the environment to retrieve resources from."}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","url":"\/documentation\/adyen\/environment"},"doc://Adyen/documentation/Adyen":{"abstract":[],"kind":"symbol","url":"\/documentation\/adyen","title":"Adyen","type":"topic","identifier":"doc:\/\/Adyen\/documentation\/Adyen","role":"collection"},"AdvancedFlow.md":{"identifier":"AdvancedFlow.md","url":"AdvancedFlow.md","title":"Advanced Flow","type":"link","titleInlineContent":[{"type":"text","text":"Advanced Flow"}]}}}