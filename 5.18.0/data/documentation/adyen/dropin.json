{"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/DropIn","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"If the simplified checkout flow with the "},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to "},{"type":"reference","isActive":true,"identifier":"AdvancedFlow.md"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Setting-up-the-Drop-in","text":"Setting up the Drop-in","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"All Components need an "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","type":"reference","isActive":true},{"text":". An instance of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Please read more "},{"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","isActive":true,"type":"reference"},{"text":" about the client key and how to get one.","type":"text"}]},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"Environment.test","type":"codeVoice"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"overridingTitle":"live environments","type":"reference","overridingTitleInlineContent":[{"text":"live environments","type":"text"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"We recommend creating a new context for each payment attempt."}]},{"code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"AdyenSession.Configuration"},{"text":" with the response you received from the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" call and the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true},{"type":"text","text":" instance."}]},{"code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Call the static ","type":"text"},{"type":"codeVoice","code":"initialize"},{"type":"text","text":" function of the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance."}],"type":"paragraph"},{"type":"codeListing","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Create a configuration object for ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true,"type":"reference"},{"text":". Check specific payment method pages to confirm if you need to include additional required parameters.","type":"text"}]},{"code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Some payment methods need additional configuration. For example ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent","type":"reference"},{"type":"text","text":". These payment method specific configuration parameters can be set in an instance of "},{"code":"DropInComponent.Configuration","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Also for voucher payment methods like Doku variants, in order for the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","isActive":true},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"code":"NSPhotoLibraryAddUsageDescription","type":"codeVoice"},{"type":"text","text":" key in the application "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]},{"text":"Presenting the Drop-in","anchor":"Presenting-the-Drop-in","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent"},{"text":" class and set the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":" instance as the "},{"code":"delegate","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"partialPaymentDelegate"},{"text":" (if needed) of the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent"},{"text":" instance.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""]},{"type":"heading","level":3,"text":"Implementing `AdyenSessionDelegate`","anchor":"Implementing-AdyenSessionDelegate"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"type":"text","text":". To handle the results of the Drop-in, the following methods of "},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"type":"text","text":" should be implemented:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"]},{"inlineContent":[{"type":"text","text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling "},{"code":"finalizeIfNeeded","type":"codeVoice"},{"text":" on the component.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"]},{"inlineContent":[{"type":"text","text":"This method is invoked when an error occurred during the use of the Drop-in or the components."},{"type":"text","text":" "},{"type":"text","text":"You can then call the "},{"code":"finalizeIfNeeded","type":"codeVoice"},{"type":"text","text":" on the component, dismiss the component’s view controller in the completion callback and display an error message."}],"type":"paragraph"},{"syntax":"swift","code":["func didOpenExternalApplication(component: DropInComponent)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}],"type":"paragraph"},{"text":"Handling an action","anchor":"Handling-an-action","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Receiving-redirect","level":3,"text":"Receiving redirect","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In case the customer is redirected to an external URL or App, make sure to let the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent"},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":":"}]},{"syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"],"type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"variants":[{"paths":["\/documentation\/adyen\/dropin"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"metadata":{"role":"article","roleHeading":"Article","title":"DropIn","modules":[{"name":"Adyen"}]},"abstract":[{"text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"text":" response, and handles the entire checkout flow under the hood for most of use cases.","type":"text"}],"references":{"doc://Adyen/documentation/Adyen/AdyenSession":{"title":"AdyenSession","abstract":[{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"type":"text","text":" acts as the delegate for the checkout payment flow."},{"type":"text","text":" "},{"type":"text","text":"It can handle the required steps internally such as "},{"code":"\/payments","type":"codeVoice"},{"type":"text","text":" and "},{"code":"\/payment\/details","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"calls and partial payment calls, then provide feedback"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true},{"type":"text","text":" methods."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenSession","kind":"identifier"}],"navigatorTitle":[{"text":"AdyenSession","kind":"identifier"}],"url":"\/documentation\/adyen\/adyensession","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},"doc://Adyen/documentation/Adyen/ApplePayComponent":{"title":"ApplePayComponent","role":"symbol","url":"\/documentation\/adyen\/applepaycomponent","abstract":[{"text":"A component that handles Apple Pay payments.","type":"text"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ApplePayComponent"}],"navigatorTitle":[{"text":"ApplePayComponent","kind":"identifier"}]},"doc://Adyen/documentation/Adyen/DokuComponent":{"type":"topic","navigatorTitle":[{"text":"DokuComponent","kind":"identifier"}],"title":"DokuComponent","url":"\/documentation\/adyen\/dokucomponent","abstract":[{"type":"text","text":"A component that provides a form for Doku Wallet, Doku Alfamart, and Doku Indomaret  payments."}],"kind":"symbol","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"DokuComponent","kind":"identifier"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent"},"https://docs.adyen.com/development-resources/client-side-authentication":{"title":"here","type":"link","identifier":"https:\