:"paragraph"}],"name":"Important","style":"important"}],"kind":"content"}],"abstract":[{"type":"text","text":"The issuer number of the highest scheme you listed under "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”.","type":"text"},{"type":"text","text":" "},{"text":"The value is clamped between 0 and 39.","type":"text"}],"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/TwintSDKActionComponent\/Configuration-swift.struct\/maxIssuerNumber","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/twintsdkactioncomponent\/configuration-swift.struct\/maxissuernumber"]}],"kind":"symbol","references":{"doc://Adyen/documentation/Adyen/TwintSDKActionComponent":{"abstract":[{"text":"A component that handles Twint SDK action’s.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"TwintSDKActionComponent","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/TwintSDKActionComponent","kind":"symbol","title":"TwintSDKActionComponent","url":"\/documentation\/adyen\/twintsdkactioncomponent","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TwintSDKActionComponent"}]},"doc://Adyen/documentation/Adyen/TwintSDKActionComponent/Configuration-swift.struct/maxIssuerNumber":{"abstract":[{"type":"text","text":"The issuer number of the highest scheme you listed under "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"text":" ","type":"text"},{"text":"The value is clamped between 0 and 39.","type":"text"}],"role":"symbol","url":"\/documentation\/adyen\/twintsdkactioncomponen