{"sections":[],"metadata":{"role":"article","modules":[{"name":"Adyen"}],"title":"Customization","roleHeading":"Article"},"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Localization","level":2,"text":"Localization"},{"type":"paragraph","inlineContent":[{"text":"To customize strings, see: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Styling","text":"Styling","level":2},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"type":"codeListing","syntax":"swift","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"]}]},{"content":[{"code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"type":"codeListing","syntax":"swift"}],"title":"Components"}]},{"type":"heading","anchor":"Custom-Payment-Method-Display-Information","text":"Custom Payment Method Display Information","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following examples provide custom information to show for a specific payment method"}]},{"type":"tabNavigator","tabs":[{"content":[{"type":"codeListing","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"syntax":"swift"},{"code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}]},{"code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"type":"codeListing","syntax":"swift"}],"title":"Drop-in"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For components you can either set the "},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"type":"strong","inlineContent":[{"type":"text","text":"Drop-In"}]},{"type":"text","text":"."}]},{"code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"type":"codeListing","syntax":"swift"}],"title":"Components"}]},{"type":"paragraph","inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference"},{"text":".","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/adyen\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"kind":"article","identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"references":{"doc://adyen.Adyen/documentation/Adyen/Localization":{"title":"Localization","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"code":"LocalizationParameters","type":"codeVoice"},{"text":" object. You can configure these settings for both the Drop-in and individual Components through their ","type":"text"},{"code":"configuration.localizationParameters","type":"codeVoice"},{"text":" property.","type":"text"}],"role":"article","kind":"article","url":"\/documentation\/adyen\/localization","type":"topic"},"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","abstract":[{"type":"text","text":"The Adyen Checkout SDK API Reference."}],"role":"article","url":"\/documentation\/adyen\/api-reference","kind":"article","type":"topic","title":"API Reference"},"doc://adyen.Adyen/documentation/Adyen":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","title":"Adyen","