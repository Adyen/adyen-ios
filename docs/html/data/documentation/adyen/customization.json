"inlineContent":[{"text":"Drop-In","type":"text"}]},{"type":"text","text":"."}]},{"syntax":"swift","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"type":"codeListing"}],"title":"Components"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a full list of customization options can be found in the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference"},{"type":"text","text":"."}]}]}],"kind":"article","identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"references":{"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"title":"API Reference","url":"\/documentation\/adyen\/api-reference","role":"article","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","type":"topic","kind":"article","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}]},"doc://adyen.Adyen/documentation/Adyen/Localization":{"url":"\/documentation\/adyen\/localization","type":"topic","role":"article","title":"Localization","abstract":[{"type":"text","text":"The SDK allows you to customize UI strings and manage locale behavior using the "},{"code":"LocalizationParameters","type":"codeVoice"},{"type":"text","text":" object. You can configure these settings for both the Drop-in and individual Components through their "},{"code":"configuration.localizationParameters","type":"codeVoice"},{"type":"text","text":" property."}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","kind":"article"},"doc://adyen.Adyen/documentation/Adyen":{"abstract":[],"title":"Adyen","role":"collection","url":"\/documentation\/adyen","kind":"symbol","identifier":"doc: