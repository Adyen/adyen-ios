{"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Localization","text":"Localization"},{"inlineContent":[{"type":"text","text":"To customize strings, see: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Styling","level":2,"anchor":"Styling","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"type":"codeListing","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"syntax":"swift"}]},{"content":[{"syntax":"swift","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"type":"codeListing"}],"title":"Components"}]},{"text":"Custom Payment Method Display Information","anchor":"Custom-Payment-Method-Display-Information","type":"heading","level":2},{"inlineContent":[{"text":"The following examples provide custom information to show for a specific payment method","type":"text"}],"type":"paragraph"},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"syntax":"swift","type":"codeListing"},{"code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To override the display information for stored payment methods use:","type":"text"}]},{"type":"codeListing","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"syntax":"swift"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For components you can either set the "},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"inlineContent":[{"type":"text","text":"Drop-In"}],"type":"strong"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"]}],"title":"Components"}]},{"inlineContent":[{"type":"text","text":"For a full list of customization options can be found in the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Customization","role":"article","modules":[{"name":"Adyen"}],"roleHeading":"Article"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"references":{"doc://Adyen/documentation/Adyen/API-Reference":{"kind":"article","url":"\/documentation\/adyen\/api-reference","abstract":[{"text":"The Adyen DropIn\/Components SDK API Reference.","type":"text"}],"type":"topic","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","title":"API Reference","role":"article"},"doc://Adyen/documentation/Adyen/Localization":{"url":"\/documentation\/adyen\/localization","kind":"article","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"type":"codeVoice","code":"LocalizationParameters"},{"text":" object. You can configure these settings for both the Drop-in and individual Components through their ","type":"text"},{"code":"configuration.localizationParameters","type":"codeVoice"},{"text":" property.","type":"text"}],"type":"topic","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","title":"Localization","role":"article"},"doc://Adyen/documentation/Adyen":{"role":"collection","title":"Adyen","abstract":[],"identifier":"doc:\/\/Adyen\/documentation\/Adyen","type":"topic","url":"\/documentation\/adyen","kind":"symbol"}}}