{"metadata":{"title":"Customization","roleHeading":"Article","modules":[{"name":"Adyen"}],"role":"article"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Localization","anchor":"Localization","level":2,"type":"heading"},{"inlineContent":[{"text":"To customize strings, see: ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Styling","anchor":"Styling","level":2,"type":"heading"},{"inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}],"type":"paragraph"},{"tabs":[{"title":"Drop-in","content":[{"syntax":"swift","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"type":"codeListing"}]},{"title":"Components","content":[{"code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"syntax":"swift","type":"codeListing"}]}],"type":"tabNavigator"},{"text":"Custom Payment Method Display Information","anchor":"Custom-Payment-Method-Display-Information","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The following examples provide custom information to show for a specific payment method"}],"type":"paragraph"},{"tabs":[{"content":[{"syntax":"swift","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"type":"codeListing"},{"syntax":"swift","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}],"type":"paragraph"},{"syntax":"swift","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"type":"codeListing"}],"title":"Drop-in"},{"content":[{"inlineContent":[{"text":"For components you can either set the ","type":"text"},{"code":"merchantProvidedDisplayInformation","type":"codeVoice"},{"text":" directly before creating the component or use the same approach as with ","type":"text"},{"inlineContent":[{"text":"Drop-In","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"syntax":"swift","type":"codeListing"}],"title":"Components"}],"type":"tabNavigator"},{"inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization"},"kind":"article","abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"references":{"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"role":"article","type":"topic","title":"API Reference","kind":"article","abstract":[{"text":"The Adyen DropIn\/Components SDK API Reference.","type":"text"}],"url":"\/documentation\/adyen\/api-reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference"},"doc://adyen.Adyen/documentation/Adyen/Localization":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","url":"\/documentation\/adyen\/localization","role":"article","title":"Localization","type":"topic","kind":"article","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"code":"LocalizationParameters","type":"codeVoice"},{"text":" object. You can configure these settings for both the Drop-in and individual Components through their ","type":"text"},{"code":"configuration.localizationParameters","type":"codeVoice"},{"text":" property.","type":"text"}]},"doc://adyen.Adyen/documentation/Adyen":{"url":"\/documentation\/adyen","kind":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","title":"Ad