{"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Localization","level":2,"type":"heading","anchor":"Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To customize strings, see: "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Styling","text":"Styling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"syntax":"swift","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"type":"codeListing"}]},{"title":"Components","content":[{"code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"syntax":"swift","type":"codeListing"}]}]},{"type":"heading","level":2,"anchor":"Custom-Payment-Method-Display-Information","text":"Custom Payment Method Display Information"},{"type":"paragraph","inlineContent":[{"text":"The following examples provide custom information to show for a specific payment method","type":"text"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"type":"codeListing","syntax":"swift","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"]},{"type":"codeListing","syntax":"swift","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"]},{"inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"]}]},{"title":"Components","content":[{"inlineContent":[{"text":"For components you can either set the ","type":"text"},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"inlineContent":[{"type":"text","text":"Drop-In"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"]}]}]},{"type":"paragraph","inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","isActive":true},{"type":"text","text":"."}]}]}],"variants":[{"paths":["\/documentation\/adyen\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Article","modules":[{"name":"Adyen"}],"role":"article","title":"Customization"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization"},"references":{"doc://adyen.Adyen/documentation/Adyen":{"type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/adyen","title":"Adyen"},"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"kind":"article","type":"topic","title":"API Reference","abstract":[{"text":"The Adyen DropIn\/Components SDK API Reference.","type":"text"}],"url":"\/documentation\/adyen\/api-reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","role":"article"},"doc://adyen.Adyen/documentation/Adyen/Localization":{"type":"topic","kind":"article","title":"Localization","abstract":[{"text":"Both the Drop-in and the Components offer a an option to customize the strings to match the usecase \/ tone of voice your app.","type":"text"}],"url":"\/documentation\/adyen\/localization","role":"article","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization"}}}