{"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/adyen\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"abstract":[{"text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app.","type":"text"}],"primaryContentSections":[{"content":[{"anchor":"Localization","type":"heading","text":"Localization","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To customize strings, see: "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","isActive":true},{"type":"text","text":"."}]},{"text":"Styling","level":2,"type":"heading","anchor":"Styling"},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"type":"codeListing","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"syntax":"swift"}]},{"content":[{"code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"syntax":"swift","type":"codeListing"}],"title":"Components"}]},{"text":"Custom Payment Method Display Information","type":"heading","level":2,"anchor":"Custom-Payment-Method-Display-Information"},{"inlineContent":[{"text":"The following examples provide custom information to show for a specific payment method","type":"text"}],"type":"paragraph"},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"syntax":"swift","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"type":"codeListing"},{"type":"codeListing","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To override the display information for stored payment methods use:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"]}]},{"title":"Components","content":[{"inlineContent":[{"type":"text","text":"For components you can either set the "},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"inlineContent":[{"text":"Drop-In","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a full list of customization options can be found in the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","isActive":true,"type":"reference"},{"type":"text","text":"."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"sections":[],"metadata":{"modules":[{"name":"Adyen"}],"title":"Customization","roleHeading":"Article","role":"article"},"references":{"doc://Adyen/documentation/Adyen":{"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/adyen","title":"Adyen","abstract":[],"identifier":"doc:\/\/Adyen\/documentation\/Adyen"},"doc://Adyen/documentation/Adyen/API-Reference":{"abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}],"type":"topic","role":"article","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","title":"API Reference","kind":"article","url":"\/documentation\/adyen\/api-reference"},"doc://Adyen/documentation/Adyen/Localization":{"abstract":[{"text":"Both the Drop-in and the Components offer a an option to customize the strings to match the usecase \/ tone of voice your app.","type":"text"}],"type":"topic","role":"article","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","title":"Localization","kind":"article","url":"\/documentation\/adyen\/localization"}}}