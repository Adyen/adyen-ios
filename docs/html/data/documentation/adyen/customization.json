{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"abstract":[{"text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"metadata":{"title":"Customization","roleHeading":"Article","role":"article","modules":[{"name":"Adyen"}]},"primaryContentSections":[{"kind":"content","content":[{"text":"Localization","type":"heading","level":2,"anchor":"Localization"},{"type":"paragraph","inlineContent":[{"text":"To customize strings, see: ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","type":"reference","isActive":true},{"text":".","type":"text"}]},{"text":"Styling","type":"heading","level":2,"anchor":"Styling"},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"type":"tabNavigator","tabs":[{"content":[{"code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"syntax":"swift","type":"codeListing"}],"title":"Drop-in"},{"content":[{"syntax":"swift","type":"codeListing","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"]}],"title":"Components"}]},{"text":"Custom Payment Method Display Information","type":"heading","level":2,"anchor":"Custom-Payment-Method-Display-Information"},{"type":"paragraph","inlineContent":[{"text":"The following examples provide custom information to show for a specific payment method","type":"text"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"type":"codeListing","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}],"type":"paragraph"},{"type":"codeListing","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"syntax":"swift"}]},{"title":"Components","content":[{"type":"paragraph","inlineContent":[{"text":"For components you can either set the ","type":"text"},{"code":"merchantProvidedDisplayInformation","type":"codeVoice"},{"text":" directly before creating the component or use the same approach as with ","type":"text"},{"inlineContent":[{"type":"text","text":"Drop-In"}],"type":"strong"},{"text":".","type":"text"}]},{"type":"codeListing","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"syntax":"swift"}]}]},{"type":"paragraph","inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","isActive":true},{"text":".","type":"text"}]}]}],"sections":[],"kind":"article","identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"references":{"doc://adyen.Adyen/documentation/Adyen":{"abstract":[],"role":"collection","url":"\/documentation\/adyen","kind":"symbol","title":"Adyen","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","type":"topic"},"doc://adyen.Adyen/documentation/Adyen/Localization":{"kind":"article","title":"Localization","url":"\/documentation\/adyen\/localization","type":"topic","role":"article","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"code":"LocalizationParameters","type":"codeVoice"},{"text":" object. You can configure these settings for both the Drop-in and individual Components through their ","type":"text"},{"code":"configuration.localizationParameters","type":"codeVoice"},{"text":" property.","type":"text"}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization"},"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"abstract":[{"text":"The Adyen DropIn\/Components SDK API Reference.","type":"text"}],"url":"\/documentation\/adyen\/api-reference","title":"API Reference","kind":"article","identifier":"doc:\/\/adyen.Adyen\/documentation\/