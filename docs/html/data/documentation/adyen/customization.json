on = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"type":"codeListing","syntax":"swift"}],"title":"Components"}]},{"type":"paragraph","inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"variants":[{"paths":["\/documentation\/adyen\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app.","type":"text"}],"references":{"doc://Adyen/documentation/Adyen/API-Reference":{"type":"topic","kind":"article","title":"API Reference","url":"\/documentation\/adyen\/api-reference","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","role":"article"},"doc://Adyen/documentation/Adyen":{"url":"\/documentation\/adyen","identifier":"doc:\/\/Adyen\/documentation\/Adyen","abstract":[],"title":"Adyen","kind":"symbol","type":"topic","role":"collection"},"doc://Adyen/documentation/Adyen/Localization":{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","abstract":[{"text":"Both the Drop-in and the Components offer a an option to customize the strings to match the usecase \/ tone of voice your app.","type":"text"}],"url":"\/documentation\/adyen\/localization","type":"topic","title":"Localization","kind":"article","role":"article"}}}