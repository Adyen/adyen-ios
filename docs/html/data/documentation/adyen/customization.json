{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Localization","level":2,"text":"Localization","type":"heading"},{"inlineContent":[{"type":"text","text":"To customize strings, see: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Styling","level":2,"text":"Styling","type":"heading"},{"inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}],"type":"paragraph"},{"tabs":[{"title":"Drop-in","content":[{"code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"syntax":"swift","type":"codeListing"}]},{"title":"Components","content":[{"type":"codeListing","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"syntax":"swift"}]}],"type":"tabNavigator"},{"anchor":"Custom-Payment-Method-Display-Information","level":2,"text":"Custom Payment Method Display Information","type":"heading"},{"inlineContent":[{"text":"The following examples provide custom information to show for a specific payment method","type":"text"}],"type":"paragraph"},{"tabs":[{"title":"Drop-in","content":[{"syntax":"swift","type":"codeListing","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"]},{"syntax":"swift","type":"codeListing","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"]},{"type":"paragraph","inlineContent":[{"text":"To override the display information for stored payment methods use:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"]}]},{"title":"Components","content":[{"inlineContent":[{"type":"text","text":"For components you can either set the "},{"code":"merchantProvidedDisplayInformation","type":"codeVoice"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"type":"strong","inlineContent":[{"text":"Drop-In","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"syntax":"swift","type":"codeListing"}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"abstract":[{"text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app.","type":"text"}],"variants":[{"paths":["\/documentation\/adyen\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"Adyen"}],"role":"article","title":"Customization"},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","references":{"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"title":"API Reference","kind":"article","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","role":"article","type":"topic","url":"\/documentation\/adyen\/api-reference","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}]},"doc://adyen.Adyen/documentation/Adyen":{"kind":"symbol","type":"topic","role":"collection","title":"Adyen","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","url":"\/documentation\/adyen","abstract":[]},"doc://adyen.Adyen/documentation/Adyen/Localization":{"url":"\/documentation\/adyen\/localization","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"code":"LocalizationParameters","type":"codeVoice"},{"text":" object. You can configure these settings for both the Drop-in and individual Components through their ","type":"text"},{"code":"configuration.localizationParameters","type":"codeVoice"},{"text":" property.","type":"text"}],"type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","kind":"article","role":"article","title":"Localization"}}}