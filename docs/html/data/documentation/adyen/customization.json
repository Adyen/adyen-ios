{"abstract":[{"text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app.","type":"text"}],"metadata":{"roleHeading":"Article","modules":[{"name":"Adyen"}],"role":"article","title":"Customization"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Localization","type":"heading","anchor":"Localization"},{"inlineContent":[{"text":"To customize strings, see: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Styling","type":"heading","anchor":"Styling"},{"inlineContent":[{"type":"text","text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:"}],"type":"paragraph"},{"tabs":[{"content":[{"type":"codeListing","syntax":"swift","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"]}],"title":"Drop-in"},{"content":[{"type":"codeListing","syntax":"swift","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"]}],"title":"Components"}],"type":"tabNavigator"},{"level":2,"text":"Custom Payment Method Display Information","type":"heading","anchor":"Custom-Payment-Method-Display-Information"},{"inlineContent":[{"text":"The following examples provide custom information to show for a specific payment method","type":"text"}],"type":"paragraph"},{"tabs":[{"content":[{"code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}],"type":"paragraph"},{"code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"type":"codeListing","syntax":"swift"}],"title":"Drop-in"},{"content":[{"inlineContent":[{"text":"For components you can either set the ","type":"text"},{"code":"merchantProvidedDisplayInformation","type":"codeVoice"},{"text":" directly before creating the component or use the same approach as with ","type":"text"},{"inlineContent":[{"text":"Drop-In","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"type":"codeListing"}],"title":"Components"}],"type":"tabNavigator"},{"inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/adyen\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"references":{"doc://adyen.Adyen/documentation/Adyen/Localization":{"url":"\/documentation\/adyen\/localization","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","role":"article","kind":"article","type":"topic","title":"Localization","abstract":[{"type":"text","text":"The SDK allows you to customize UI strings and manage locale behavior using the "},{"type":"codeVoice","code":"LocalizationParameters"},{"type":"text","text":" object. You can configure these settings for both the Drop-in and individual Components through their "},{"type":"codeVoice","code":"configuration.localizationParameters"},{"type":"text","text":" property."}]},"doc://adyen.Adyen/documentation/Adyen":{"type":"topic","role":"collection","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","kind":"symbol","abstract":[],"url":"\/documentation\/adyen","title":"Adyen"},"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"title":"API Reference","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}],"role":"article","kind":"article","type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","url":"\/documentation\/adyen\/api-reference"}}}