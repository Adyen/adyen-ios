{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Localization","text":"Localization"},{"inlineContent":[{"type":"text","text":"To customize strings, see: "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Styling","level":2,"type":"heading","text":"Styling"},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"tabs":[{"content":[{"type":"codeListing","syntax":"swift","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"]}],"title":"Drop-in"},{"content":[{"code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"type":"codeListing","syntax":"swift"}],"title":"Components"}],"type":"tabNavigator"},{"type":"heading","text":"Custom Payment Method Display Information","anchor":"Custom-Payment-Method-Display-Information","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following examples provide custom information to show for a specific payment method"}]},{"tabs":[{"title":"Drop-in","content":[{"type":"codeListing","syntax":"swift","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"]},{"type":"codeListing","syntax":"swift","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"]},{"inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}],"type":"paragraph"},{"type":"codeListing","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"syntax":"swift"}]},{"content":[{"inlineContent":[{"type":"text","text":"For components you can either set the "},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"type":"strong","inlineContent":[{"type":"text","text":"Drop-In"}]},{"text":".","type":"text"}],"type":"paragraph"},{"code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"type":"codeListing","syntax":"swift"}],"title":"Components"}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"metadata":{"role":"article","title":"Customization","modules":[{"name":"Adyen"}],"roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization"},"abstract":[{"text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app.","type":"text"}],"variants":[{"paths":["\/documentation\/adyen\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"references":{"doc://adyen.Adyen/documentation/Adyen":{"type":"topic","abstract":[],"title":"Adyen","role":"collection","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","kind":"symbol","url":"\/documentation\/adyen"},"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"kind":"article","url":"\/documentation\/adyen\/api-reference","abstract":[{"text":"The Adyen DropIn\/Components SDK API Reference.","type":"text"}],"title":"API Reference","role":"article","type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference"},"doc://adyen.Adyen/documentation/Adyen/Localization":{"role":"article","type":"topic","title":"Localization","url":"\/documentation\/adyen\/localization","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","kind":"article","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"code":"LocalizationParameters","type":"codeVoice"},{"type":"text","text":" object. You can configure these settings for both the Drop-in and individual Components through their "},{"type":"codeVoice","code":"configuration.localizationParameters"},{"type":"text","text":" property."}]}}}