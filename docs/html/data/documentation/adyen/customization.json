{"metadata":{"roleHeading":"Article","modules":[{"name":"Adyen"}],"title":"Customization","role":"article"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Localization","level":2,"anchor":"Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To customize strings, see: "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"heading","text":"Styling","level":2,"anchor":"Styling"},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"type":"codeListing","syntax":"swift","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"]}]},{"title":"Components","content":[{"type":"codeListing","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                            