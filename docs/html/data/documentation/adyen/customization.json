-In","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"syntax":"swift","type":"codeListing"}],"title":"Components"}]},{"inlineContent":[{"type":"text","text":"For a full list of customization options can be found in the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"kind":"article","metadata":{"modules":[{"name":"Adyen"}],"roleHeading":"Article","title":"Customization","role":"article"},"references":{"doc://Adyen/documentation/Adyen":{"kind":"symbol","abstract":[],"role":"collection","identifier":"doc:\/\/Adyen\/documentation\/Adyen","type":"topic","url":"\/documentation\/adyen","title":"Adyen"},"doc://Adyen/documentation/Adyen/API-Reference":{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","url":"\/documentation\/adyen\/api-reference","kind":"article","role":"article","type":"topic","abstract":[{"text":"The Adyen DropIn\/Components SDK API Reference.","type":"text"}],"title":"API Reference"},"doc://Adyen/documentation/Adyen/Localization":{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","type":"topic","url":"\/documentation\/adyen\/localization","kind":"article","role":"article","title":"Localization","abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a an option to customize the strings to match the usecase \/ tone of voice your app."}]}}}