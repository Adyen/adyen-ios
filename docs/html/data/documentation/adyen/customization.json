{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Localization","level":2,"type":"heading","anchor":"Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To customize strings, see: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization"},{"type":"text","text":"."}]},{"text":"Styling","level":2,"type":"heading","anchor":"Styling"},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"syntax":"swift","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"type":"codeListing"}]},{"title":"Components","content":[{"code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"type":"codeListing","syntax":"swift"}]}]},{"text":"Custom Payment Method Display Information","level":2,"type":"heading","anchor":"Custom-Payment-Method-Display-Information"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following examples provide custom information to show for a specific payment method"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"type":"codeListing","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}],"type":"paragraph"},{"type":"codeListing","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"syntax":"swift"}]},{"title":"Components","content":[{"type":"paragraph","inlineContent":[{"text":"For components you can either set the ","type":"text"},{"code":"merchantProvidedDisplayInformation","type":"codeVoice"},{"text":" directly before creating the component or use the same approach as with ","type":"text"},{"inlineContent":[{"text":"Drop-In","type":"text"}],"type":"strong"},{"text":".","type":"text"}]},{"code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"syntax":"swift","type":"codeListing"}]}]},{"type":"paragraph","inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference"},{"text":".","type":"text"}]}]}],"identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"abstract":[{"text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app.","type":"text"}],"metadata":{"roleHeading":"Article","modules":[{"name":"Adyen"}],"role":"article","title":"Customization"},"references":{"doc://adyen.Adyen/documentation/Adyen":{"url":"\/documentation\/adyen","type":"topic","kind":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","title":"Adyen","role":"collection","abstract":[]},"doc://adyen.Adyen/documentation/Adyen/Localization":{"type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"type":"codeVoice","code":"LocalizationParameters"},{"text":" object. You can configure these settings for both the Drop-in and individual Components through their ","type":"text"},{"type":"codeVoice","code":"configuration.localizationParameters"},{"text":" property.","type":"text"}],"title":"Localization","role":"article","url":"\/documentation\/adyen\/localization","kind":"article"},"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"type":"topic","abstract":[{"text":"The Adyen DropIn\/Components SDK API Reference.","type":"text"}],"url":"\/documentation\/adyen\/api-reference","role":"article","title":"API Reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","kind":"article"}}}