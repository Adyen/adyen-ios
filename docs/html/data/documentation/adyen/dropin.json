 = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""]},{"anchor":"Implementing-AdyenSessionDelegate","type":"heading","level":3,"text":"Implementing `AdyenSessionDelegate`"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"text":". To handle the results of the Drop-in, the following methods of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"text":" should be implemented:","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"syntax":"swift","type":"codeListing","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"]},{"inlineContent":[{"text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling ","type":"text"},{"code":"finalizeIfNeeded","type":"codeVoice"},{"text":" on the component.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"syntax":"swift","type":"codeListing","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"]},{"inlineContent":[{"type"