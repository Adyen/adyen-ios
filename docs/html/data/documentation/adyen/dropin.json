{"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the simplified checkout flow with the "},{"code":"\/sessions","type":"codeVoice"},{"text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to ","type":"text"},{"isActive":true,"type":"reference","identifier":"AdvancedFlow.md"},{"type":"text","text":"."}]},{"level":2,"text":"Setting up the Drop-in","type":"heading","anchor":"Setting-up-the-Drop-in"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All Components need an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext"},{"type":"text","text":". An instance of "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Please read more "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"},{"type":"text","text":" about the client key and how to get one."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Environment.test"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"isActive":true,"overridingTitle":"live environments","type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"We recommend creating a new context for each payment attempt.","type":"text"}]},{"code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"text":" with the response you received from the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" call and the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":" instance.","type":"text"}]},{"code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call the static "},{"code":"initialize","type":"codeVoice"},{"type":"text","text":" function of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Create a configuration object for ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true,"type":"reference"},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}]},{"code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Some payment methods need additional configuration. For example "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent","type":"reference","isActive":true},{"text":". These payment method specific configuration parameters can be set in an instance of ","type":"text"},{"code":"DropInComponent.Configuration","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Also for voucher payment methods like Doku variants, in order for the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","isActive":true},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"type":"text","text":" key in the application "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]},{"text":"Presenting the Drop-in","anchor":"Presenting-the-Drop-in","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"type":"text","text":" class and set the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" instance as the "},{"code":"delegate","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"partialPaymentDelegate"},{"text":" (if needed) of the ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","type":"reference","isActive":true},{"text":" instance.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""]},{"text":"Implementing `AdyenSessionDelegate`","type":"heading","anchor":"Implementing-AdyenSessionDelegate","level":3},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"type":"text","text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference","isActive":true},{"type":"text","text":". To handle the results of the Drop-in, the following methods of "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference","isActive":true},{"type":"text","text":" should be implemented:"}]},{"syntax":"swift","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling "},{"code":"finalizeIfNeeded","type":"codeVoice"},{"text":" on the component.","type":"text"}]},{"code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This method is invoked when an error occurred during the use of the Drop-in or the components.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"You can then call the "},{"code":"finalizeIfNeeded","type":"codeVoice"},{"type":"text","text":" on the component, dismiss the component’s view controller in the completion callback and display an error message."}]},{"syntax":"swift","code":["func didOpenExternalApplication(component: DropInComponent)"],"type":"codeListing"},{"inlineContent":[{"text":"This optional method is invoked after a redirect to an external application has occurred.","type":"text"}],"type":"paragraph"},{"text":"Handling an action","type":"heading","anchor":"Handling-an-action","level":2},{"inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","anchor":"Receiving-redirect","level":3,"text":"Receiving redirect"},{"inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent","type":"reference"},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"code":"UIApplicationDelegate","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"],"type":"codeListing"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"modules":[{"name":"Adyen"}],"title":"DropIn","roleHeading":"Article","role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Adyen\/documentation\/Adyen\/DropIn"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/dropin"]}],"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"kind":"article","abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"code":"\/sessions","type":"codeVoice"},{"text":" response, and handles the entire checkout flow under the hood for most of use cases.","type":"text"}],"references":{"doc://Adyen/documentation/Adyen/AdyenSession":{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"AdyenSession","kind":"identifier"}],"title":"AdyenSession","abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/