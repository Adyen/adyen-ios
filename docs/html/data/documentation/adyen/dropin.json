{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Adyen\/documentation\/Adyen\/DropIn"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"DropIn","modules":[{"name":"Adyen"}],"roleHeading":"Article","role":"article"},"abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"code":"\/sessions","type":"codeVoice"},{"text":" response, and handles the entire checkout flow under the hood for most of use cases.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"If the simplified checkout flow with the "},{"code":"\/sessions","type":"codeVoice"},{"text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to ","type":"text"},{"isActive":true,"identifier":"AdvancedFlow.md","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Setting up the Drop-in","anchor":"Setting-up-the-Drop-in","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"All Components need an ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","type":"reference","isActive":true},{"text":". An instance of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Please read more "},{"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","type":"reference","isActive":true},{"text":" about the client key and how to get one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Environment.test"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","isActive":true,"overridingTitle":"live environments","overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"We recommend creating a new context for each payment attempt.","type":"text"}]},{"code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"type":"text","text":" with the response you received from the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" call and the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true},{"type":"text","text":" instance."}],"type":"paragraph"},{"type":"codeListing","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call the static "},{"type":"codeVoice","code":"initialize"},{"type":"text","text":" function of the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance.","type":"text"}]},{"code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a configuration object for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent"},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some payment methods need additional configuration. For example "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent","type":"reference","isActive":true},{"text":". These payment method specific configuration parameters can be set in an instance of ","type":"text"},{"type":"codeVoice","code":"DropInComponent.Configuration"},{"type":"text","text":":"}]},{"syntax":"swift","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"],"type":"codeListing"},{"inlineContent":[{"text":"Also for voucher payment methods like Doku variants, in order for the ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","type":"reference","isActive":true},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"text":" key in the application ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Presenting the Drop-in","level":2,"anchor":"Presenting-the-Drop-in"},{"inlineContent":[{"text":"Initialize the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","type":"reference"},{"type":"text","text":" class and set the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"text":" instance as the ","type":"text"},{"type":"codeVoice","code":"delegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"partialPaymentDelegate"},{"text":" (if needed) of the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"type":"text","text":" instance."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""]},{"anchor":"Implementing-AdyenSessionDelegate","level":3,"text":"Implementing `AdyenSessionDelegate`","type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"type":"text","text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"type":"text","text":". To handle the results of the Drop-in, the following methods of "},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"text":" should be implemented:","type":"text"}]},{"type":"codeListing","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling ","type":"text"},{"type":"codeVoice","code":"finalizeIfNeeded"},{"text":" on the component.","type":"text"}]},{"syntax":"swift","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This method is invoked when an error occurred during the use of the Drop-in or the components.","type":"text"},{"type":"text","text":" "},{"text":"You can then call the ","type":"text"},{"code":"finalizeIfNeeded","type":"codeVoice"},{"text":" on the component, dismiss the component’s view controller in the completion callback and display an error message.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func didOpenExternalApplication(component: DropInComponent)"]},{"inlineContent":[{"text":"This optional method is invoked after a redirect to an external application has occurred.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Handling-an-action","text":"Handling an action"},{"inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Receiving redirect","anchor":"Receiving-redirect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent"},{"text":" know when the user returns to your app. Do this by implementing the following in your ","type":"text"},{"code":"UIApplicationDelegate","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"]}]}],"variants":[{"paths":["\/documentation\/adyen\/dropin"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Adyen/documentation/Adyen/AdyenSession":{"navigatorTitle":[{"text":"AdyenSession","kind":"identifier"}],"kind":"symbol","title":"AdyenSession","url":"\/documentation\/adyen\/adyensession","type":"topic","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","abstract":[{"type":"reference","identifier":"doc:\/\/Adyen\/do