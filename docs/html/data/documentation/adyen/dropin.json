"abstract":[{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"text":" acts as the delegate for the checkout payment flow.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It can handle the required steps internally such as "},{"type":"codeVoice","code":"\/payments"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/payment\/details"},{"type":"text","text":" "},{"text":"calls and partial payment calls, then provide feedback","type":"text"},{"type":"text","text":" "},{"type":"text","text":"via "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true},{"type":"text","text":" methods."}],"role":"symbol"},"doc://Adyen/documentation/Adyen/AdyenSessionDelegate":{"role":"symbol","abstract":[{"text":"Describes the methods a delegate of ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"type":"text","text":" needs to implement."}],"url":"\/documentation\/adyen\/adyensessiondelegate","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AdyenSessionDelegate"}],"kind":"symbol","navigatorTitle":[{"text":"AdyenSessionDelegate","kind":"identifier"}],"title":"AdyenSessionDelegate"}}}