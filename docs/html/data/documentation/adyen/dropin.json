 ","kind":"text"},{"text":"DropInComponent","kind":"identifier"}],"type":"topic","url":"\/documentation\/adyen\/dropincomponent","kind":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","abstract":[{"type":"text","text":"A component that handles the entire flow of payment selection and payment details entry."}],"title":"DropInComponent","role":"symbol","navigatorTitle":[{"text":"DropInComponent","kind":"identifier"}]},"doc://adyen.Adyen/documentation/Adyen/DokuComponent":{"title":"DokuComponent","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DokuComponent","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A component that provides a form for Doku Wallet, Doku Alfamart, and Doku Indomaret  payments."}],"navigatorTitle":[{"text":"DokuComponent","kind":"identifier"}],"url":"\/documentation\/adyen\/dokucomponent","type":"topic","kind":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent"},"doc://adyen.Adyen/documentation/Adyen":{"role":"collection","abstract":[],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","kind":"symbol","title":"Adyen","url":"\/documentation\/adyen","type":"topic"},"doc://adyen.Adyen/documentation/Adyen/ApplePayComponent":{"kind":"symbol","abstract":[{"text":"A component that handles Apple Pay payments.","type":"text"}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ApplePayComponent","kind":"identifier"}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","url":"\/documentation\/adyen\/applepaycomponent","navigatorTitle":[{"text":"ApplePayComponent","kind":"identifier"}],"type":"topic","title":"ApplePayComponent"}}}