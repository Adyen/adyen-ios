{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/dropin"]}],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"sections":[],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropIn"},"metadata":{"modules":[{"name":"Adyen"}],"title":"DropIn","role":"article","roleHeading":"Article"},"abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" response, and handles the entire checkout flow under the hood for most of use cases."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"If the simplified checkout flow with the ","type":"text"},{"type":"codeVoice","code":"\/sessions"},{"text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to ","type":"text"},{"identifier":"AdvancedFlow.md","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","level":2,"text":"Setting up the Drop-in","anchor":"Setting-up-the-Drop-in"},{"type":"paragraph","inlineContent":[{"text":"All Components need an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},{"text":". An instance of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"text":" ","type":"text"},{"text":"Please read more ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"},{"text":" about the client key and how to get one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Environment.test"},{"text":" during testing. When you’re ready to accept live payments, change the value to one of our ","type":"text"},{"isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"type":"reference","overridingTitle":"live environments","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Environment"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"We recommend creating a new context for each payment attempt."}]},{"type":"codeListing","syntax":"swift","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"]},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"text":" with the response you received from the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"text":" call and the ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":" instance.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call the static "},{"code":"initialize","type":"codeVoice"},{"type":"text","text":" function of the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance."}]},{"type":"codeListing","syntax":"swift","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Create a configuration object for ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","isActive":true,"type":"reference"},{"text":". Check specific payment method pages to confirm if you need to include additional required parameters.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some payment methods need additional configuration. For example "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","isActive":true},{"type":"text","text":". These payment method specific configuration parameters can be set in an instance of "},{"code":"DropInComponent.Configuration","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Also for voucher payment methods like Doku variants, in order for the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent"},{"type":"text","text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the "},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"type":"text","text":" key in the application "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]},{"type":"heading","text":"Presenting the Drop-in","anchor":"Presenting-the-Drop-in","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"type":"text","text":" class and set the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":" instance as the "},{"code":"delegate","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"partialPaymentDelegate"},{"type":"text","text":" (if needed) of the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent"},{"type":"text","text":" instance."}]},{"type":"codeListing","syntax":"swift","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""]},{"level":3,"type":"heading","text":"Implementing `AdyenSessionDelegate`","anchor":"Implementing-AdyenSessionDelegate"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true},{"type":"text","text":". To handle the results of the Drop-in, the following methods of "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true},{"type":"text","text":" should be implemented:"}]},{"type":"thematicBreak"},{"type":"codeListing","syntax":"swift","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"]},{"type":"paragraph","inlineContent":[{"text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling ","type":"text"},{"type":"codeVoice","code":"finalizeIfNeeded"},{"text":" on the component.","type":"text"}]},{"type":"thematicBreak"},{"type":"codeListing","syntax":"swift","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is invoked when an error occurred during the use of the Drop-in or the components."},{"type":"text","text":" "},{"type":"text","text":"You can then call the "},{"type":"codeVoice","code":"finalizeIfNeeded"},{"type":"text","text":" on the component, dismiss the component’s view controller in the completion callback and display an error message."}]},{"type":"thematicBreak"},{"type":"codeListing","syntax":"swift","code":["func didOpenExternalApplication(component: DropInComponent)"]},{"type":"paragraph","inlineContent":[{"text":"This optional method is invoked after a redirect to an external application has occurred.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"Handling an action","anchor":"Handling-an-action"},{"type":"paragraph","inlineContent":[{"text":"Actions are handled by the Drop-in via its delegate ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"text":".","type":"text"}]},{"level":3,"type":"heading","text":"Receiving redirect","anchor":"Receiving-redirect"},{"type":"paragraph","inlineContent":[{"text":"In case the customer is redirected to an external URL or App, make sure to let the ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent","type":"reference","isActive":true},{"text":" know when the user returns to your app. Do this by implementing the following in your ","type":"text"},{"type":"codeVoice","code":"UIApplicationDelegate"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"]}],"kind":"content"}],"references":{"doc://adyen.Adyen/documentation/Adyen":{"kind":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","title":"Adyen",