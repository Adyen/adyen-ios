{"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"If the simplified checkout flow with the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to "},{"type":"reference","identifier":"AdvancedFlow.md","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","anchor":"Setting-up-the-Drop-in","text":"Setting up the Drop-in","level":2},{"inlineContent":[{"type":"text","text":"All Components need an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},{"type":"text","text":". An instance of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},{"type":"text","text":" wraps your client key, environment, payment, analytics configuration and so on."},{"type":"text","text":" "},{"type":"text","text":"Please read more "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"},{"type":"text","text":" about the client key and how to get one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Environment.test"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Environment","type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"overridingTitle":"live environments"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"We recommend creating a new context for each payment attempt.","type":"text"}],"type":"paragraph"},{"code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"text":" with the response you received from the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"text":" call and the ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","type":"reference","isActive":true},{"text":" instance.","type":"text"}],"type":"paragraph"},{"code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Call the static ","type":"text"},{"code":"initialize","type":"codeVoice"},{"text":" function of the ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance.","type":"text"}],"type":"paragraph"},{"code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Create a configuration object for "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","type":"reference","isActive":true},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}],"type":"paragraph"},{"code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Some payment methods need additional configuration. For example ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","type":"reference"},{"text":". These payment method specific configuration parameters can be set in an instance of ","type":"text"},{"code":"DropInComponent.Configuration","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Also for voucher payment methods like Doku variants, in order for the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","isActive":true},{"type":"text","text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the "},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"type":"text","text":" key in the application "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","anchor":"Presenting-the-Drop-in","text":"Presenting the Drop-in","level":2},{"inlineContent":[{"text":"Initialize the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent"},{"text":" class and set the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"text":" instance as the ","type":"text"},{"code":"delegate","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"partialPaymentDelegate","type":"codeVoice"},{"text":" (if needed) of the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Implementing-AdyenSessionDelegate","text":"Implementing `AdyenSessionDelegate`","level":3},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"type":"text","text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, "},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"type":"text","text":". To handle the results of the Drop-in, the following methods of "},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"type":"text","text":" should be implemented:"}],"type":"paragraph"},{"type":"thematicBreak"},{"code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling "},{"type":"codeVoice","code":"finalizeIfNeeded"},{"type":"text","text":" on the component."}],"type":"paragraph"},{"type":"thematicBreak"},{"code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This method is invoked when an error occurred during the use of the Drop-in or the components."},{"type":"text","text":" "},{"type":"text","text":"You can then call the "},{"code":"finalizeIfNeeded","type":"codeVoice"},{"type":"text","text":" on the component, dismiss the component’s view controller in the completion callback and display an error message."}],"type":"paragraph"},{"type":"thematicBreak"},{"code":["func didOpenExternalApplication(component: DropInComponent)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}],"type":"paragraph"},{"type":"thematicBreak"},{"type":"heading","anchor":"Handling-an-action","text":"Handling an action","level":2},{"inlineContent":[{"text":"Actions are handled by the Drop-in via its delegate ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Receiving-redirect","text":"Receiving redirect","level":3},{"inlineContent":[{"text":"In case the customer is redirected to an external URL or App, make sure to let the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent"},{"text":" know when the user returns to your app. Do this by implementing the following in your ","type":"text"},{"code":"UIApplicationDelegate","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/adyen\/dropin"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropIn"},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"metadata":{"roleHeading":"Article","title":"DropIn","role":"article","modules":[{"name":"Adyen"}]},"abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" response, and handles the entire checkout flow under the hood for most of use cases."}],"references":{"doc://adyen.Adyen/documentation/Adyen/AdyenSessionDelegate":{"abstract":[{"text":"Describes the methods a delegate of ","type":"t