{"kind":"article","hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"code":"\/sessions","type":"codeVoice"},{"text":" response, and handles the entire checkout flow under the hood for most of use cases.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"If the simplified checkout flow with the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to ","type":"text"},{"isActive":true,"type":"reference","identifier":"AdvancedFlow.md"},{"type":"text","text":"."}]},{"anchor":"Setting-up-the-Drop-in","level":2,"type":"heading","text":"Setting up the Drop-in"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All Components need an "},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","type":"reference"},{"type":"text","text":". An instance of "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"type":"text","text":" wraps your client key, environment, payment, analytics configuration and so on."},{"type":"text","text":" "},{"type":"text","text":"Please read more "},{"type":"reference","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","isActive":true},{"text":" about the client key and how to get one.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Use "},{"code":"Environment.test","type":"codeVoice"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"isActive":true,"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","overridingTitle":"live environments"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"We recommend creating a new context for each payment attempt."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"AdyenSession.Configuration"},{"type":"text","text":" with the response you received from the "},{"type":"codeVoice","code":"\/sessions"},{"text":" call and the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext"},{"type":"text","text":" instance."}]},{"code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Call the static ","type":"text"},{"code":"initialize","type":"codeVoice"},{"type":"text","text":" function of the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Create a configuration object for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","type":"reference"},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}]},{"code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Some payment methods need additional configuration. For example ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent","type":"reference","isActive":true},{"type":"text","text":". These payment method specific configuration parameters can be set in an instance of "},{"code":"DropInComponent.Configuration","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Also for voucher payment methods like Doku variants, in order for the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","type":"reference","isActive":true},{"type":"text","text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the "},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"type":"text","text":" key in the application "},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Presenting-the-Drop-in","type":"heading","text":"Presenting the Drop-in","level":2},{"inlineContent":[{"type":"text","text":"Initialize the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true,"type":"reference"},{"text":" class and set the ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"type":"text","text":" instance as the "},{"code":"delegate","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"partialPaymentDelegate"},{"type":"text","text":" (if needed) of the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true,"type":"reference"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""]},{"type":"heading","level":3,"anchor":"Implementing-AdyenSessionDelegate","text":"Implementing `AdyenSessionDelegate`"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference","isActive":true},{"text":". To handle the results of the Drop-in, the following methods of ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true,"type":"reference"},{"type":"text","text":" should be implemented:"}]},{"type":"codeListing","syntax":"swift","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"]},{"type":"paragraph","inlineContent":[{"text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling ","type":"text"},{"type":"codeVoice","code":"finalizeIfNeeded"},{"text":" on the component.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is invoked when an error occurred during the use of the Drop-in or the components."},{"type":"text","text":" "},{"text":"You can then call the ","type":"text"},{"type":"codeVoice","code":"finalizeIfNeeded"},{"type":"text","text":" on the component, dismiss the component’s view controller in the completion callback and display an error message."}]},{"syntax":"swift","type":"codeListing","code":["func didOpenExternalApplication(component: DropInComponent)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}]},{"text":"Handling an action","level":2,"type":"heading","anchor":"Handling-an-action"},{"inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Receiving redirect","level":3,"type":"heading","anchor":"Receiving-redirect"},{"type":"paragraph","inlineContent":[{"text":"In case the customer is redirected to an external URL or App, make sure to let the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent","isActive":true},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"]}]}],"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/DropIn","interfaceLanguage":"swift"},"sections":[],"metadata":{"modules":[{"name":"Adyen"}],"title":"DropIn","role":"article","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/dropin"]}],"references":{"doc://Adyen/documentation/Adyen/DropInComponent":{"abstract":[{"type":"text","text":"A component that handles the entire flow of payment selection and payment details entry."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"DropInComponent","kind":"identifier"}],"url":"\/documentation\/adyen\/dropincomponent","navigatorTitle":[{"text":"DropInComponent","kind":"identifier"}],"type":"topic","title":"DropInComponent","role":"symbol","kind":"symbol","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent"},"doc://Adyen/documentation/Adyen/DokuComponent":{"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"DokuComponent","kind":"identifier"}],"kind":"symbol","title":"DokuComponent","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","navigatorTitle":[{"kind":"identifier","text":"DokuComponent"}],"role":"symbol","abstract":[{"type":"text","text":"A component that provides a form for Doku Wallet, Doku Alfamart, and Doku Indomaret  payments."}],"url":"\/documentation\/adyen\/dokucomponent"},"https://docs.adyen.com/development-resources/client-side-authentication":{"url":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","title":"here","titleInlineContent":[{"type":"text","text":"here"}],"type":"link","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"},"doc://Adyen/documentation/Adyen/Environment":{"role":"symbol","navigatorTitle":[{"text":"Environment","kind":"identifier"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","title":"Environment","abstract":[{"type":"text","text":"Struct that defines the environment to retrieve resources from."}],"kind":"symbol","url":"\/documentation\/adyen\/environment","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"Environment","kind":"identifier"}],"type":"topic"},"doc://Adyen/documentation/Adyen/AdyenSession":{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","url":"\/documentation\/adyen\/adyensession","kind":"symbol","navigatorTitle":[{"text":"AdyenSession","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"AdyenSession","kind":"identifier"}],"abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" acts as the delegate for the checkout payment flow."},{"text":" ","type":"text"},{"type":"text","text":"It can handle the required steps internally such as "},{"code":"\/payments","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/payment\/details"},{"text":" ","type":"text"},{"text":"calls and partial payment calls, then provide feedback","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true,"type":"reference"},{"type":"text","text":" methods."}],"role":"symbol","type":"topic","title":"AdyenSession"},"doc://Adyen/documentation/Adyen/RedirectComponent":{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent","kind":"symbol","url":"\/documentation\/adyen\/redirectcomponent","navigatorTitle":[{"text":"RedirectComponent","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RedirectComponent"}],"abstract":[{"text":"Handles any redirect Url whether its a web url, an App custom scheme url, or an app universal link.","type":"text"}],"role":"symbol","type":"topic","title":"RedirectComponent"},"AdvancedFlow.md":{"titleInlineContent":[{"type":"text","text":"Advanced Flow"}],"title":"Advanced Flow","url":"AdvancedFlow.md","type":"link","identifier":"AdvancedFlow.md"},"doc://Adyen/documentation/Adyen/AdyenContext":{"url":"\/documentation\/adyen\/adyencontext","abstract":[{"type":"text","text":"A class that defines the behavior of the components in a payment flow."}],"kind":"symbol","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","title":"AdyenContext","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AdyenContext"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AdyenContext"}],"type":"topic"},"doc://Adyen/documentation/Adyen":{"type":"topic","kind":"symbol","url":"\/documentation\/adyen","title":"Adyen","abstract":[],"identifier":"doc:\/\/Adyen\/documentation\/Adyen","role":"collection"},"doc://Adyen/documentation/Adyen/AdyenSessionDelegate":{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","kind":"symbol","url":"\/documentation\/adyen\/adyensessiondelegate","navigatorTitle":[{"text":"AdyenSessionDelegate","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdyenSessionDelegate"}],"abstract":[{"type":"text","text":"Describes the methods a delegate of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" needs to implement."}],"role":"symbol","type":"topic","title":"AdyenSessionDelegate"},"doc://Adyen/documentation/Adyen/ApplePayComponent":{"role":"symbol","kind":"symbol","abstract":[{"text":"A component that handles Apple Pay payments.","type":"text"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent","url":"\/documentation\/adyen\/applepaycomponent","title":"ApplePayComponent","navigatorTitle":[{"text":"ApplePayComponent","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ApplePayComponent"}],"type":"topic"}}}