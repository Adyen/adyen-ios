{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/DropIn","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"metadata":{"roleHeading":"Article","role":"article","title":"DropIn","modules":[{"name":"Adyen"}]},"variants":[{"paths":["\/documentation\/adyen\/dropin"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the ","type":"text"},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" response, and handles the entire checkout flow under the hood for most of use cases."}],"kind":"article","sections":[],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the simplified checkout flow with the "},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to "},{"isActive":true,"type":"reference","identifier":"AdvancedFlow.md"},{"text":".","type":"text"}]},{"text":"Setting up the Drop-in","type":"heading","anchor":"Setting-up-the-Drop-in","level":2},{"inlineContent":[{"text":"All Components need an ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","type":"reference","isActive":true},{"type":"text","text":". An instance of "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"text":" ","type":"text"},{"text":"Please read more ","type":"text"},{"type":"reference","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","isActive":true},{"text":" about the client key and how to get one.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"Environment.test","type":"codeVoice"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","overridingTitle":"live environments","isActive":true,"overridingTitleInlineContent":[{"text":"live environments","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"We recommend creating a new context for each payment attempt.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"type":"text","text":" with the response you received from the "},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" call and the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext"},{"type":"text","text":" instance."}]},{"syntax":"swift","type":"codeListing","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"]},{"inlineContent":[{"type":"text","text":"Call the static "},{"code":"initialize","type":"codeVoice"},{"type":"text","text":" function of the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"]},{"inlineContent":[{"text":"Create a configuration object for ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","type":"reference","isActive":true},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}],"type":"paragraph"},{"code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Some payment methods need additional configuration. For example ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent","type":"reference","isActive":true},{"text":". These payment method specific configuration parameters can be set in an instance of ","type":"text"},{"code":"DropInComponent.Configuration","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Also for voucher payment methods like Doku variants, in order for the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","type":"reference"},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"text":" key in the application ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Presenting-the-Drop-in","type":"heading","text":"Presenting the Drop-in","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"text":" class and set the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"text":" instance as the ","type":"text"},{"code":"delegate","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"partialPaymentDelegate"},{"text":" (if needed) of the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent"},{"text":" instance.","type":"text"}]},{"syntax":"swift","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""],"type":"codeListing"},{"text":"Implementing `AdyenSessionDelegate`","type":"heading","anchor":"Implementing-AdyenSessionDelegate","level":3},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"type":"text","text":". To handle the results of the Drop-in, the following methods of "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference","isActive":true},{"text":" should be implemented:","type":"text"}]},{"code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling ","type":"text"},{"type":"codeVoice","code":"finalizeIfNeeded"},{"text":" on the component.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"]},{"inlineContent":[{"text":"This method is invoked when an error occurred during the use of the Drop-in or the components.","type":"text"},{"type":"text","text":" "},{"text":"You can then call the ","type":"text"},{"type":"codeVoice","code":"finalizeIfNeeded"},{"type":"text","text":" on the component, dismiss the component’s view controller in the completion callback and display an error message."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func didOpenExternalApplication(component: DropInComponent)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}]},{"text":"Handling an action","anchor":"Handling-an-action","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"text":".","type":"text"}]},{"text":"Receiving redirect","anchor":"Receiving-redirect","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent","isActive":true,"type":"reference"},{"text":" know when the user returns to your app. Do this by implementing the following in your ","type":"text"},{"code":"UIApplicationDelegate","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"]}],"kind":"content"}],"references":{"doc://Adyen/documentation/Adyen/DropInComponent":{"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DropInComponent"}],"title":"DropInComponent","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","url":"\/documentation\/adyen\/dropincomponent","navigatorTitle":[{"kin