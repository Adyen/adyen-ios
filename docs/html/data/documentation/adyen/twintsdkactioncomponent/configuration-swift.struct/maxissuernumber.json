{"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"maxIssuerNumber"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"aside","content":[{"inlineContent":[{"text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"For this to work, "},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"text":" must include “twint-extended”.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If you configure any "},{"code":"maxIssuerNumber","type":"codeVoice"},{"type":"text","text":" below 39, the result will always contain all apps above "},{"code":"maxIssuerNumber","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"up to and including 39, even if none of them are installed."},{"text":" ","type":"text"},{"type":"text","text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing."}],"type":"paragraph"}],"name":"Important","style":"important"}]}],"sections":[],"identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/TwintSDKActionComponent\/Configuration-swift.struct\/maxIssuerNumber","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/twintsdkactioncomponent\/configuration-swift.struct\/maxissuernumber"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","metadata":{"modules":[{"name":"Adyen"}],"externalID":"s:5Adyen23TwintSDKActionComponentC13ConfigurationV15maxIssuerNumberSivp","symbolKind":"property","roleHeading":"Instance Property","title":"maxIssuerNumber","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"maxIssuerNumber","kind":"identifier"},{"kind":"text","text":": "},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen","doc:\/\/adyen.Adyen\/documentation\/Adyen\/TwintSDKActionComponent","doc:\/\/adyen.Adyen\/documentation\/Adyen\/TwintSDKActionComponent\/Configuration-swift.struct"]]},"abstract":[{"type":"text","text":"The issuer number of the highest scheme you listed under "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The value is clamped between 0 and 39."}],"references":{"doc://adyen.Adyen/documentation/Adyen/TwintSDKActionComponent":{"kind":"symbol","url":"\/documentation\/adyen\/twintsdkactioncomponent","type":"topic","abstract":[{"text":"A component that handles Twint SDK action’s.","type":"text"}],"title":"TwintSDKActionComponent","navigatorTitle":[{"kind":"identifier","text":"TwintSDKActionComponent"}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/TwintSDKActionComponent","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TwintSDKActionComponent"}]},"doc://adyen.Adyen/documentation/Adyen/TwintSDKActionComponent/Configuration-swift.struct":{"role":"symbol","title":"TwintSDKActionComponent.Configuration","abstract":[{"type":"text","text":"The TwintSDK component configurations."}],"url":"\/documentation\/adyen\/twintsdkactioncomponent\/configuration-swift.struct","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Configuration","kind":"identifier"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Configuration"}],"identifier":"doc:\/\/ady