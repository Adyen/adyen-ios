{"sections":[],"identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/TwintSDKActionComponent\/Configuration-swift.struct\/maxIssuerNumber","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"platforms":["iOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"content":[{"type":"paragraph","inlineContent":[{"text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed.","type":"text"},{"text":" ","type":"text"},{"text":"For this to work, ","type":"text"},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"text":" must include “twint-extended”.","type":"text"},{"text":" ","type":"text"},{"text":"If you configure any ","type":"text"},{"code":"maxIssuerNumber","type":"codeVoice"},{"text":" below 39, the result will always contain all apps above ","type":"text"},{"code":"maxIssuerNumber","type":"codeVoice"},{"text":" ","type":"text"},{"text":"up to and including 39, even if none of them are installed.","type":"text"},{"text":" ","type":"text"},{"text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing.","type":"text"}]}],"type":"aside","style":"important","name":"Important"}]}],"kind":"symbol","metadata":{"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"symbolKind":"property","title":"maxIssuerNumber","externalID":"s:5Adyen23TwintSDKActionComponentC13ConfigurationV15maxIssuerNumberSivp","modules":