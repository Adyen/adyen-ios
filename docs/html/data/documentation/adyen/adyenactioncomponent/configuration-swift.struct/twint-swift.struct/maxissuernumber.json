{"abstract":[{"type":"text","text":"The issuer number of the highest scheme you listed under "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"type":"text","text":" "},{"type":"text","text":"The value is clamped between 0 and 39."}],"metadata":{"externalID":"s:5Adyen0A15ActionComponentC13ConfigurationV5TwintV15maxIssuerNumberSivp","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"role":"symbol","title":"maxIssuerNumber","modules":[{"name":"Adyen"}],"symbolKind":"property"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct\/Twint-swift.struct\/maxIssuerNumber"},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen","doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenActionComponent","doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct","doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct\/Twint-swift.struct"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":