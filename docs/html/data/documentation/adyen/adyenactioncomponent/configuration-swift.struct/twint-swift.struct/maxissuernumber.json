{"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen","doc:\/\/Adyen\/documentation\/Adyen\/AdyenActionComponent","doc:\/\/Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct","doc:\/\/Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct\/Twint-swift.struct"]]},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/adyenactioncomponent\/configuration-swift.struct\/twint-swift.struct\/maxissuernumber"]}],"sections":[],"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"role":"symbol","modules":[{"name":"Adyen"}],"title":"maxIssuerNumber","externalID":"s:5Adyen0A15ActionComponentC13ConfigurationV5TwintV15maxIssuerNumberSivp","symbolKind":"property","roleHeading":"Instance Property"},"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct\/Twint-swift.struct\/maxIssuerNumber","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"maxIssuerNumber","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed."},{"type":"text","text":" "},{"type":"text","text":"For this to work, "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"text":" must include “twint-extended”.","type":"text"},{"type":"text","text":" "},{"text":"If you configure any ","type":"text"},{"type":"codeVoice","code":"maxIssuerNumber"},{"text":" below 39, the result will always contain all apps above ","type":"text"},{"type":"codeVoice","code":"maxIssuerNumber"},{"type":"text","text":" "},{"type":"text","text":"up to and including 39, even if none of them are installed."},{"type":"text","text":" "},{"type":"text","text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing."}]}],"type":"aside"}]}],"abstract":[{"type":"text","text":"The issuer number of the highest scheme you listed under "},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"type":"text","text":" "},{"type":"text","text":"The value is clamped between 0 and 39."}],"references":{"doc://Adyen/documentation/Adyen":{"type":"topic","kind":"symbol","url":"\/documentation\/adyen","role":"collection","identifier":"doc:\/\/Adyen\/documentation\/Adyen","title":"Adyen","abstract":[]},"doc://Adyen/documentation/Adyen/AdyenActionComponent/Configuration-swift.struct/Twint-swift.struct/maxIssuerNumber":{"title":"maxIssuerNumber","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"maxIssuerNumber"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"abstract":[{"text":"The issuer number of the highest scheme you listed under ","type":"text"},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”.","type":"text"},{"text":" ","type":"text"},{"text":"The value is clamped between 0 and 39.","type":"text"}],"type":"topic","identifier":"doc:\/\/