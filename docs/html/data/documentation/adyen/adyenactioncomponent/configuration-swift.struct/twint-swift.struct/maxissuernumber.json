{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct\/Twint-swift.struct\/maxIssuerNumber"},"abstract":[{"type":"text","text":"The issuer number of the highest scheme you listed under "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"text":" ","type":"text"},{"text":"The value is clamped between 0 and 39.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxIssuerNumber","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"languages":["swift"]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"content":[{"type":"paragraph","inlineContent":[{"text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"For this to work, "},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"text":" must include “twint-extended”.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"If you configure any "},{"code":"maxIssuerNumber","type":"codeVoice"},{"text":" below 39, the result will always contain all apps above ","type":"text"},{"type":"codeVoice","code":"maxIssuerNumber"},{"type":"text","text":" "},{"text":"up to and including 39, even if none of them are installed.","type":"text"},{"type":"text","text":" "},{"text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing.","type":"text"}]}],"name":"Important","style":"important","type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Ady