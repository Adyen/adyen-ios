{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"maxIssuerNumber","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed."},{"text":" ","type":"text"},{"type":"text","text":"For this to work, "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":" must include “twint-extended”."},{"text":" ","type":"text"},{"type":"text","text":"If you configure any "},{"code":"maxIssuerNumber","type":"codeVoice"},{"text":" below 39, the result will always contain all apps above ","type":"text"},{"type":"codeVoice","code":"maxIssuerNumber"},{"type":"text","text":" "},{"text":"up to and including 39, even if none of them are installed.","type":"text"},{"text":" ","type":"text"},{"text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing.","type":"text"}]}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen","doc:\/\/Adyen\/documentation\/Adyen\/AdyenActionComponent","doc:\/\/Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct","doc:\/\/Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct\/Twint-swift.struct"]]},"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"maxIssuerNumber","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"externalID":"s:5Adyen0A15ActionComponentC13ConfigurationV5TwintV15maxIssuerNumberSivp",