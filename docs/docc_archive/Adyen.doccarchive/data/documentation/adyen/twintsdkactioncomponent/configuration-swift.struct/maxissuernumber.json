hest scheme you listed under "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"type":"text","text":" "},{"type":"text","text":"The value is clamped between 0 and 39."}],"kind":"symbol","title":"maxIssuerNumber","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/TwintSDKActionComponent\/Configuration-swift.struct\/maxIssuerNumber","role":"symbol","type":"topic"},"doc://adyen.Adyen/documentation/Adyen":{"role":"collection","title":"Adyen","url":"\/documentation\/adyen","type":"topic","kind":"symbol","abstract":[],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen"},"doc://adyen.Adyen/documentation/Adyen/TwintSDKActionComponent":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/TwintSDKActionComponent","title":"TwintSDKActionComponent","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TwintSDKActionComponent"}],"kind":"symbol","abstract":[{"type":"text","text":"A component that handles Twint SDK action’s."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"TwintSDKActionComponent"}],"url":"\/documentation\/adyen\/twintsdkactioncomponent","role":"symbol"}}}