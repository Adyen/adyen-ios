{"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen","doc:\/\/adyen.Adyen\/documentation\/Adyen\/TwintSDKActionComponent","doc:\/\/adyen.Adyen\/documentation\/Adyen\/TwintSDKActionComponent\/Configuration-swift.struct"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/TwintSDKActionComponent\/Configuration-swift.struct\/maxIssuerNumber"},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed.","type":"text"},{"text":" ","type":"text"},{"text":"For this to work, ","type":"text"},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":" must include “twint-extended”."},{"type":"text","text":" "},{"type":"text","text":"If you configure any "},{"type":"codeVoice","code":"maxIssuerNumber"},{"type":"text","text":" below 39, the result will always contain all apps above "},{"type":"codeVoice","code":"maxIssuerNumber"},{"type":"text","text":" "},{"type":"text","text":"up to and including 39, even if none of them are installed."},{"type":"text","text":" "},{"type":"text","text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing."}]}],"name":"Important"}],"kind":"content"}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"text":"The issuer number of the highest scheme you listed under ","type":"text"},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”.","type":"text"},{"text":" ","type":"text"},{"text":"The value is clamped between 0 and 39.","type":"text"}],"variants":[{"paths":["\/documentation\/adyen\/twintsdkactioncomponent\/configuration-swift.struct\/maxissuernumber"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"maxIssuerNumber","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxIssuerNumber","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"role":"symbol","symbolKind":"property","modules":[{"name":"Adyen"}],"externalID":"s:5Adyen23TwintSDKActionComponentC13ConfigurationV15maxIssuerNumberSivp"},"references":{"doc://adyen.Adyen/documentation/Adyen":{"kind":"symbol","abstract":[],"title":"Adyen","type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","role":"collection","url":"\/documentation\/adyen"},"doc://adyen.Adyen/documentation/Adyen/TwintSDKActionComponent/Configuration-swift.struct/maxIssuerNumber":{"role":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/TwintSDKActionComponent\/Configuration-swift.struct\/maxIssuerNumber","url":"\/documentation\/adyen\/twintsdkactioncomponent\/configuration-swift.struct\/maxissuernumber","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"abstract":[{"type":"text","text":"The issuer number of the highest scheme you listed under "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"type":"text","text":