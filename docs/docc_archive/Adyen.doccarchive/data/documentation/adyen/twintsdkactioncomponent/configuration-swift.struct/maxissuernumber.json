mber of the highest scheme you listed under ","type":"text"},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"type":"text","text":" "},{"type":"text","text":"The value is clamped between 0 and 39."}],"metadata":{"symbolKind":"property","modules":[{"name":"Adyen"}],"title":"maxIssuerNumber","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxIssuerNumber","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"externalID":"s:5Adyen23TwintSDKActionComponentC13ConfigurationV15maxIssuerNumberSivp","role":"symbol"},"references":{"doc://Adyen/documentation/Adyen":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/Adyen\/documentation\/Adyen","type":"topic","title":"Adyen","role":"collection","url":"\/documentation\/adyen"},"doc://Adyen/documentation/Adyen/TwintSDKActionComponent/Configuration-swift.struct/maxIssuerNumber":{"kind":"symbol","abstract":[{"type":"text","text":"The issuer number of the highest scheme you listed under "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"type":"text","text":" "},{"type":"text","text":"The value is clamped between 0 and 39."}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/TwintSDKActionComponent\/Configuration-swift.struct\/maxIssuerNumber","title":"maxIssuerNumber","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"maxIssuerNumber","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"url":"\/documentation\/adyen\/twintsd