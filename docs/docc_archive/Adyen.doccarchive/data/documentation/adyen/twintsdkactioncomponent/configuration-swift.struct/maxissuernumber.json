{"kind":"symbol","abstract":[{"text":"The issuer number of the highest scheme you listed under ","type":"text"},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”.","type":"text"},{"text":" ","type":"text"},{"text":"The value is clamped between 0 and 39.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxIssuerNumber","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed."},{"type":"text","text":" "},{"type":"text","text":"For this to work, "},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"type":"text","text":" must include “twint-extended”."},{"type":"text","text":" "},{"type":"text","text":"If you configure any "},{"code":"maxIssuerNumber","type":"codeVoice"},{"type":"text","text":" below 39, the result will always contain all apps above "},{"code":"maxIssuerNumber","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"up to and including 39, even if none of them are installed."},{"type":"text","text":" "},{"type":"text","text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing."}]}],"name":"Important"}],"kind":"content"}],"metadata":{"role":"symbol","symbolKind":"property","modules":[{"name":"Adyen"}],"title":"maxIssuerNumber","roleHeading":"Instance Property","exter