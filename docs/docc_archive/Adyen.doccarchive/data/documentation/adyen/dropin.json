{"abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" response, and handles the entire checkout flow under the hood for most of use cases."}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropIn","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/dropin"]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Adyen"}],"title":"DropIn"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"If the simplified checkout flow with the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to ","type":"text"},{"isActive":true,"identifier":"AdvancedFlow.md","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Setting-up-the-Drop-in","level":2,"text":"Setting up the Drop-in","type":"heading"},{"inlineContent":[{"type":"text","text":"All Components need an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},{"type":"text","text":". An instance of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},{"type":"text","text":" wraps your client key, environment, payment, analytics configuration and so on."},{"type":"text","text":" "},{"type":"text","text":"Please read more "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"},{"type":"text","text":" about the client key and how to get one."}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Environment.test"},{"text":" during testing. When you’re ready to accept live payments, change the value to one of our ","type":"text"},{"overridingTitle":"live environments","type":"reference","overridingTitleInlineContent":[{"text":"live environments","type":"text"}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Environment","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"We recommend creating a new context for each payment attempt.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"]},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"AdyenSession.Configuration"},{"type":"text","text":" with the response you received from the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" call and the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","isActive":true},{"type":"text","text":" instance."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"]},{"inlineContent":[{"type":"text","text":"Call the static "},{"code":"initialize","type":"codeVoice"},{"type":"text","text":" function of the "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"type":"text","text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"]},{"inlineContent":[{"type":"text","text":"Create a configuration object for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent"},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""]},{"inlineContent":[{"text":"Some payment methods need additional configuration. For example ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent"},{"text":". These payment method specific configuration parameters can be set in an instance of ","type":"text"},{"type":"codeVoice","code":"DropInComponent.Configuration"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"]},{"inlineContent":[{"text":"Also for voucher payment methods like Doku variants, in order for the ","type":"text"},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","isActive":true},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"code":"NSPhotoLibraryAddUsageDescription","type":"codeVoice"},{"text":" key in the application ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Presenting-the-Drop-in","level":2,"text":"Presenting the Drop-in","type":"heading"},{"inlineContent":[{"type":"text","text":"Initialize the "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","isActive":true,"type":"reference"},{"type":"text","text":" class and set the "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"type":"text","text":" instance as the "},{"code":"delegate","type":"codeVoice"},{"type":"text","text":" and "},{"code":"partialPaymentDelegate","type":"codeVoice"},{"type":"text","text":" (if needed) of the "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","isActive":true,"type":"reference"},{"type":"text","text":" instance."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""]},{"anchor":"Implementing-AdyenSessionDelegate","level":3,"text":"Implementing `AdyenSessionDelegate`","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true,"type":"reference"},{"text":". To handle the results of the Drop-in, the following methods of ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true,"type":"reference"},{"text":" should be implemented:","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"syntax":"swift","type":"codeListing","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"]},{"inlineContent":[{"type":"text","text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling "},{"type":"codeVoice","code":"finalizeIfNeeded"},{"type":"text","text":" on the component."}],"type":"paragraph"},{"type":"thematicBreak"},{"syntax":"swift","type":"codeListing","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"]},{"inlineContent":[{"text":"This method is invoked when an error occurred during the use of the Drop-in or the components.","type":"text"},{"text":" ","type":"text"},{"text":"You can then call the ","type":"text"},{"code":"finalizeIfNeeded","type":"codeVoice"},{"text":" on the component, dismiss the component’s view controller in the completion callback and display an error message.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"syntax":"swift","type":"codeListing","code":["func didOpenExternalApplication(component: DropInComponent)"]},{"inlineContent":[{"text":"This optional method is invoked after a redirect to an external application has occurred.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"Handling-an-action","level":2,"text":"Handling an action","type":"heading"},{"inlineContent":[{"text":"Actions are handled by the Drop-in via its delegate ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Receiving-redirect","level":3,"text":"Receiving redirect","type":"heading"},{"inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent"},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"]}],"kind":"content"}],"references":{"doc://adyen.Adyen/documentation/Adyen/DokuComponent":{"navigatorTitle":[{"text":"DokuComponent","kind":"identifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DokuComponent","kind":"identifier"}],"url":"\/documentation\/adyen\/dokucomponent","abstract":[{"text":"A component that provides a form for Doku Wallet, Doku Alfamart, and Doku Indomaret  payments.","type":"text"}],"kind":"symbol","title":"DokuComponent"},"doc://adyen.Adyen/documentation/Adyen/ApplePayComponent":{"type":"topic","title":"ApplePayComponent","role":"symbol","abstract":[{"type":"text","text":"A component that handles Apple Pay payments."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ApplePayComponent"}],"url":"\/documentation\/adyen\/applepaycomponent","kind":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","navigatorTitle":[{"kind":"identifier","text":"ApplePayComponent"}]},"AdvancedFlow.md":{"url":"AdvancedFlow.md","type":"link","titleInlineContent":[{"text":"Advanced Flow","type":"text"}],"title":"Advanced Flow","identifier":"AdvancedFlow.md"},"doc://adyen.Adyen/documentation/Adyen/AdyenSessionDelegate":{"role":"symbol","kind":"symbol","url":"\/documentation\/adyen\/adyensessiondelegate","abstract":[{"text":"Describes the methods a delegate of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"text":" needs to implement.","type":"text"}],"title":"AdyenSessionDelegate","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AdyenSessionDelegate"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdyenSessionDelegate"}]},"doc://adyen.Adyen/documentation/Adyen/DropInComponent":{"title":"DropInComponent","abstract":[{"text":"A component that handles the entire flow of paymen