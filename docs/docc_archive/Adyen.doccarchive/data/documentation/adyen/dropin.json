kind":"identifier","text":"AdyenContext"}],"type":"topic","url":"\/documentation\/adyen\/adyencontext","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A class that defines the behavior of the components in a payment flow."}],"navigatorTitle":[{"kind":"identifier","text":"AdyenContext"}]},"AdvancedFlow.md":{"type":"link","identifier":"AdvancedFlow.md","titleInlineContent":[{"type":"text","text":"Advanced Flow"}],"title":"Advanced Flow","url":"AdvancedFlow.md"},"doc://Adyen/documentation/Adyen/Environment":{"abstract":[{"type":"text","text":"Struct that defines the environment to retrieve resources from."}],"title":"Environment","navigatorTitle":[{"kind":"identifier","text":"Environment"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","kind":"symbol","type":"topic","url":"\/documentation\/adyen\/environment","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Environment"}]},"doc://Adyen/documentation/Adyen/DokuComponent":{"role":"symbol","abstract":[{"type":"text","text":"A component that provides a form for Doku Wallet, Doku Alfamart, and Doku Indomaret  payments."}],"title":"DokuComponent","type":"topic","url":"\/documentation\/adyen\/dokucomponent","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DokuComponent"}],"kind":"symbol","navigatorTitle":[{"text":"DokuComponent","kind":"identifier"}]},"doc://Adyen/documentation/Adyen/AdyenSession":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AdyenSession"}],"navigatorTitle":[{"kind":"identifier","text":"AdyenSession"}],"kind":"symbol","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","abstract":[{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"type":"text","text":" acts as the delegate for the checkout payment flow."},{"type":"text","text":" "},{"type":"text","text":"It can handle the required steps internally such as "},{"type":"codeVoice","code":"\/payments"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/payment\/details"},{"text":" ","type":"text"},{"text":"calls and partial payment calls, then provide feedback","type":"text"},{"type":"text","text":" "},{"type":"text","text":"via "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true},{"type":"text","text":" methods."}],"url":"\/documentation\/adyen\/adyensession","type":"topic","role":"symbol","title":"AdyenSession"},"doc://Adyen/documentation/Adyen/AdyenSessionDelegate":{"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"AdyenSessionDelegate","kind":"identifier"}],"navigatorTitle":[{"text":"AdyenSessionDelegate","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","abstract":[{"type":"text","text":"Describes the methods a delegate of "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"type":"text","text":" needs to implement."}],"url":"\/documentation\/adyen\/adyensessiondelegate","type":"topic","role":"symbol","title":"AdyenSessionDelegate"}}}