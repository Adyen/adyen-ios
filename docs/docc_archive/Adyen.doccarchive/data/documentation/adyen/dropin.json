{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/adyen\/dropin"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Adyen\/documentation\/Adyen\/DropIn"},"kind":"article","abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"type":"codeVoice","code":"\/sessions"},{"text":" response, and handles the entire checkout flow under the hood for most of use cases.","type":"text"}],"metadata":{"role":"article","roleHeading":"Article","title":"DropIn","modules":[{"name":"Adyen"}]},"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"If the simplified checkout flow with the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to "},{"identifier":"AdvancedFlow.md","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Setting-up-the-Drop-in","level":2,"text":"Setting up the Drop-in"},{"inlineContent":[{"type":"text","text":"All Components need an "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true},{"text":". An instance of ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"type":"text","text":" "},{"text":"Please read more ","type":"text"},{"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","isActive":true,"type":"reference"},{"type":"text","text":" about the client key and how to get one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"Environment.test","type":"codeVoice"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"overridingTitleInlineContent":[{"text":"live environments","type":"text"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","isActive":true,"type":"reference","overridingTitle":"live environments"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"We recommend creating a new context for each payment attempt."}]},{"code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"text":" with the response you received from the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" call and the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Call the static ","type":"text"},{"code":"initialize","type":"codeVoice"},{"type":"text","text":" function of the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"]},{"inlineContent":[{"type":"text","text":"Create a configuration object for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent"},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some payment methods need additional configuration. For example "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent","isActive":true},{"text":". These payment method specific configuration parameters can be set in an instance of ","type":"text"},{"type":"codeVoice","code":"DropInComponent.Configuration"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"],"syntax":"swift"},{"inlineContent":[{"text":"Also for voucher payment methods like Doku variants, in order for the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","isActive":true},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"type":"text","text":" key in the application "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Presenting the Drop-in","anchor":"Presenting-the-Drop-in"},{"type":"paragraph","inlineContent":[{"text":"Initialize the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent"},{"type":"text","text":" class and set the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":" instance as the "},{"type":"codeVoice","code":"delegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"partialPaymentDelegate"},{"type":"text","text":" (if needed) of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent"},{"text":" instance.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""]},{"type":"heading","text":"Implementing `AdyenSessionDelegate`","level":3,"anchor":"Implementing-AdyenSessionDelegate"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true},{"text":". To handle the results of the Drop-in, the following methods of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"type":"text","text":" should be implemented:"}]},{"syntax":"swift","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling "},{"type":"codeVoice","code":"finalizeIfNeeded"},{"text":" on the component.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is invoked when an error occurred during the use of the Drop-in or the components."},{"text":" ","type":"text"},{"text":"You can then call the ","type":"text"},{"type":"codeVoice","code":"finalizeIfNeeded"},{"type":"text","text":" on the component, dismiss the component’s view controller in the completion callback and display an error message."}]},{"type":"codeListing","syntax":"swift","code":["func didOpenExternalApplication(component: DropInComponent)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}]},{"anchor":"Handling-an-action","level":2,"text":"Handling an action","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Actions are handled by the Drop-in via its delegate ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"text":".","type":"text"}]},{"anchor":"Receiving-redirect","type":"heading","level":3,"text":"Receiving redirect"},{"inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent","isActive":true,"type":"reference"},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"],"syntax":"swift"}]}],"references":{"doc://Adyen/documentation/Adyen/ApplePayComponent":{"url":"\/documentation\/adyen\/applepaycomponent","abstract":[{"text":"A component that handles Apple Pay payments.","type":"text"}],"navigatorTitle":[{"text":"ApplePayComponent","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"i