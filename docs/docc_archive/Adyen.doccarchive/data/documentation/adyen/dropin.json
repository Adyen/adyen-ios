","present(dropInComponent.viewController, animated: true)",""],"type":"codeListing","syntax":"swift"},{"text":"Implementing `AdyenSessionDelegate`","type":"heading","level":3,"anchor":"Implementing-AdyenSessionDelegate"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"text":". To handle the results of the Drop-in, the following methods of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"text":" should be implemented:","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling ","type":"text"},{"code":"finalizeIfNeeded","type":"codeVoice"},{"text":" on the component.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This method is invoked when an error occurred during the use of the Drop-in or the components.","type":"text"},{"text":" ","type":"text"},{"text":"You can then call the ","type":"text"},{"code":"finalizeIfNeeded","type":"codeVoice"},{"text":" on the component, dismiss the component’s view controller in the completion callback and display an error message.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"cod