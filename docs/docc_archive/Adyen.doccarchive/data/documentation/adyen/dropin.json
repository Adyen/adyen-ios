e":"text"},{"type":"text","text":" "},{"type":"text","text":"It can handle the required steps internally such as "},{"code":"\/payments","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/payment\/details"},{"text":" ","type":"text"},{"text":"calls and partial payment calls, then provide feedback","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"via "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true,"type":"reference"},{"type":"text","text":" methods."}],"role":"symbol","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","title":"AdyenSession","type":"topic","navigatorTitle":[{"text":"AdyenSession","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenSession","kind":"identifier"}],"url":"\/documentation\/adyen\/adyensession","kind":"symbol"},"doc://Adyen/documentation/Adyen/AdyenContext":{"role":"symbol","kind":"symbol","url":"\/documentation\/adyen\/adyencontext","navigatorTitle":[{"text":"AdyenContext","kind":"identifier"}],"abstract":[{"type":"text","text":"A class that defines the behavior of the components in a payment flow."}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdyenContext"}],"title":"AdyenContext","type":"topic"}}}