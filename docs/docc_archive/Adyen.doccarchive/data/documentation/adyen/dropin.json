{"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" response, and handles the entire checkout flow under the hood for most of use cases."}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"If the simplified checkout flow with the ","type":"text"},{"type":"codeVoice","code":"\/sessions"},{"text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to ","type":"text"},{"type":"reference","identifier":"AdvancedFlow.md","isActive":true},{"text":".","type":"text"}]},{"type":"heading","anchor":"Setting-up-the-Drop-in","level":2,"text":"Setting up the Drop-in"},{"type":"paragraph","inlineContent":[{"text":"All Components need an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},{"text":". An instance of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"text":" ","type":"text"},{"text":"Please read more ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"},{"text":" about the client key and how to get one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Environment.test"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"type":"reference","overridingTitle":"live environments","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Environment"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"We recommend creating a new context for each payment attempt."}]},{"type":"codeListing","syntax":"swift","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"]},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"text":" with the response you received from the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"text":" call and the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},{"text":" instance.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call the static "},{"type":"codeVoice","code":"initialize"},{"type":"text","text":" function of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance."}]},{"type":"codeListing","syntax":"swift","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a configuration object for "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","type":"reference","isActive":true},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some payment methods need additional configuration. For example "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","isActive":true},{"type":"text","text":". These payment method specific configuration parameters can be set in an instance of "},{"type":"codeVoice","code":"DropInComponent.Configuration"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Also for voucher payment methods like Doku variants, in order for the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","isActive":true},{"type":"text","text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the "},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"type":"text","text":" key in the application "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Presenting-the-Drop-in","level":2,"text":"Presenting the Drop-in"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"type":"text","text":" class and set the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":" instance as the "},{"type":"codeVoice","code":"delegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"partialPaymentDelegate"},{"type":"text","text":" (if needed) of the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"type":"text","text":" instance."}]},{"type":"codeListing","syntax":"swift","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""]},{"type":"heading","anchor":"Implementing-AdyenSessionDelegate","level":3,"text":"Implementing `AdyenSessionDelegate`"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"type":"text","text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference","isActive":true},{"type":"text","text":". To handle the results of the Drop-in, the following methods of "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference","isActive":true},{"type":"text","text":" should be implemented:"}]},{"type":"thematicBreak"},{"type":"codeListing","syntax":"swift","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling "},{"code":"finalizeIfNeeded","type":"codeVoice"},{"type":"text","text":" on the component."}]},{"type":"thematicBreak"},{"type":"codeListing","syntax":"swift","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"]},{"type":"paragraph","inlineContent":[{"text":"This method is invoked when an error occurred during the use of the Drop-in or the components.","type":"text"},{"text":" ","type":"text"},{"text":"You can then call the ","type":"text"},{"code":"finalizeIfNeeded","type":"codeVoice"},{"text":" on the component, dismiss the component’s view controller in the completion callback and display an error message.","type":"text"}]},{"type":"thematicBreak"},{"type":"codeListing","syntax":"swift","code":["func didOpenExternalApplication(component: DropInComponent)"]},{"type":"paragraph","inlineContent":[{"text":"This optional method is invoked after a redirect to an external application has occurred.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","anchor":"Handling-an-action","level":2,"text":"Handling an action"},{"type":"paragraph","inlineContent":[{"text":"Actions are handled by the Drop-in via its delegate ","type":"text"},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"text":".","type":"text"}]},{"type":"heading","anchor":"Receiving-redirect","level":3,"text":"Receiving redirect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent","isActive":true},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropIn"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/dropin"]}],"kind":"article","metadata":{"title":"DropIn","roleHeading":"Article","role":"article","modules":[{"name":"Adyen"}]},"references":{"doc://adyen.Adyen/documentation/Adyen/RedirectComponent":{"abstract":[{"type":"text","text":"Handles any redirect Url whether its a web url, an App custom scheme url, or an app universal link."}],"kind":"symbol","url":"\/documentation\/adyen\/redirectcomponent","type":"topic","navigatorTitle":[{"kind":"identifier","text":"RedirectComponent"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedirectComponent"}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent","title":"RedirectComponent"},"doc://adyen.Adyen/documentation/Adyen/AdyenSession":{"title":"AdyenSession","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AdyenSession"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdyenSession"}],"url":"\/documentation\/adyen\/adyensession","abstract":[{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"type":"text","text":" acts as the delegate for the checkout payment flow."},{"type":"text","text":" "},{"type":"text","text":"It can handle the required steps internally such as "},{"type":"codeVoice","code":"\/payments"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/payment\/details"},{"type":"text","text":" "},{"type":"text","text":"calls and partial payment calls, then provide feedback"},{"type":"text","text":" "},{"type":"text","text":"via "},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"type":"text","text":" methods."}],"role":"symbol"},"https://docs.adyen.com/development-resources/client-side-authentication":{"title":"here","titleInlineContent":[{"text":"here","type":"text"}],"type":"link","url":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"},"AdvancedFlow.md":{"title":"Advanced Flow","titleInlineContent":[{"type":"text","text":"Advanced Flow"}],"type":"link","url":"AdvancedFlow.md","identifier":"AdvancedFlow.md"},"doc://adyen.Adyen/documentation/Adyen/DropInComponent":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","title":"DropInComponent","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DropInComponent"}],"abstract":[{"type":"text","text":"A component that handles the entire flow of payment selection and payment details entry."}],"navigatorTitle":[{"kind":"identifier","text":"DropInComponent"}],"kind":"symbol","url":"\/documentation\/adyen\/dropincomponent","type":"topic"},"doc://adyen.Adyen/documentation/Adyen":{"type":"topic","role":"collection","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","kind":"symbol","abstract":[],"url":"\/documentation\/adyen","title":"Adyen"},"doc://adyen.Adyen/documentation/Adyen/ApplePayComponent":{"abstract":[{"type":"text","text":"A component that handles Apple Pay payments."}],"type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ApplePayComponent","kind":"identifier"}],"navigatorTitle":[{"text":"ApplePayComponent","kind":"identifier"}],"kind":"symbol","title":"ApplePayComponent","url":"\/documentation\/adyen\/applepaycomponent","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent"},"doc://adyen.Adyen/documentation/Adyen/AdyenSessionDelegate":{"type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","title":"AdyenSessionDelegate","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Describes the methods a delegate of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" needs to implement."}],"navigatorTitle":[{"text":"AdyenSessionDelegate","kind":"identifier"}],"url":"\/documentation\/adyen\/adyensessiondelegate","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenSessionDelegate","kind":"identifier"}]},"doc://adyen.Adyen/documentation/Adyen/Environment":{"url":"\/documentation\/adyen\/environment","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Environment"}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Environment","kind":"symbol","role":"symbol","abstract":[{"text":"Struct that defines the environment to retrieve resources from.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Environment"}],"type":"topic","title":"Environment"},"doc://adyen.Adyen/documentation/Adyen/AdyenContext":{"abstract":[{"type":"text","text":"A class that defines the behavior of the components in a payment flow."}],"role":"symbol","kind":"symbol","url":"\/documentation\/adyen\/adyencontext","type":"topic","title":"AdyenContext","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenContext","kind":"identifier"}],"navigatorTitle":[{"text":"AdyenContext","kind":"identifier"}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},"doc://adyen.Adyen/documentation/Adyen/DokuComponent":{"kind":"symbol","url":"\/documentation\/adyen\/dokucomponent","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DokuComponent"}],"type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","navigatorTitle":[{"kind":"identifier","text":"DokuComponent"}],"role":"symbol","title":"DokuComponent","abstract":[{"type":"text","text":"A component that provides a form for Doku Wallet, Doku Alfamart, and Doku Indomaret  payments."}]}}}