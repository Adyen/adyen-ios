type":"paragraph","inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"Handling-an-action","text":"Handling an action","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Receiving-redirect","text":"Receiving redirect","level":3},{"type":"paragraph","inlineContent":[{"text":"In case the customer is redirected to an external URL or App, make sure to let the ","type":"text"},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent","isActive":true},{"text":" know when the user returns to your app. Do this by implementing the following in your ","type":"text"},{"code":"UIApplicationDelegate","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"]}]}],"metadata":{"modules":[{"name":"Adyen"}],"roleHeading":"Article","role":"article","title":"DropIn"},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"kind":"article","abstract":[{"text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the ","type":"text"},{"type":"codeVoice","code":"\/sessions"},{"text":" response, and handles the entire checkout flow under the hood for most of use cases.","type":"text"}],"references":{"doc://adyen.Adyen/documentation/Adyen/DropInComponent":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "}