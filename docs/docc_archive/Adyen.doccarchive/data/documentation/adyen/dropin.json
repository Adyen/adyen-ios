{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" response, and handles the entire checkout flow under the hood for most of use cases."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/dropin"]}],"metadata":{"role":"article","title":"DropIn","roleHeading":"Article","modules":[{"name":"Adyen"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Adyen\/documentation\/Adyen\/DropIn"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the simplified checkout flow with the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to "},{"isActive":true,"type":"reference","identifier":"AdvancedFlow.md"},{"text":".","type":"text"}]},{"text":"Setting up the Drop-in","type":"heading","anchor":"Setting-up-the-Drop-in","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"All Components need an "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true},{"text":". An instance of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Please read more "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"},{"text":" about the client key and how to get one.","type":"text"}]},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Environment.test"},{"text":" during testing. When you’re ready to accept live payments, change the value to one of our ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","overridingTitle":"live environments","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"We recommend creating a new context for each payment attempt."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"]},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"type":"text","text":" with the response you received from the "},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" call and the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","type":"reference","isActive":true},{"text":" instance.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"]},{"type":"paragraph","inlineContent":[{"text":"Call the static ","type":"text"},{"code":"initialize","type":"codeVoice"},{"text":" function of the ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"type":"text","text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance."}]},{"type":"codeListing","syntax":"swift","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Create a configuration object for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","type":"reference"},{"text":". Check specific payment method pages to confirm if you need to include additional required parameters.","type":"text"}]},{"type":"codeListing","code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some payment methods need additional configuration. For example "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent","isActive":true},{"text":". These payment method specific configuration parameters can be set in an instance of ","type":"text"},{"type":"codeVoice","code":"DropInComponent.Configuration"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"]},{"inlineContent":[{"text":"Also for voucher payment methods like Doku variants, in order for the ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","isActive":true,"type":"reference"},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"type":"text","text":" key in the application "},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Presenting the Drop-in","type":"heading","anchor":"Presenting-the-Drop-in"},{"inlineContent":[{"text":"Initialize the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","type":"reference"},{"text":" class and set the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"text":" instance as the ","type":"text"},{"type":"codeVoice","code":"delegate"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"partialPaymentDelegate"},{"type":"text","text":" (if needed) of the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"text":" instance.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""],"type":"codeListing"},{"level":3,"text":"Implementing `AdyenSessionDelegate`","type":"heading","anchor":"Implementing-AdyenSessionDelegate"},{"inlineContent":[{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true},{"type":"text","text":". To handle the results of the Drop-in, the following methods of "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true,"type":"reference"},{"text":" should be implemented:","type":"text"}],"type":"paragraph"},{"code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling "},{"type":"codeVoice","code":"finalizeIfNeeded"},{"text":" on the component.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is invoked when an error occurred during the use of the Drop-in or the components."},{"type":"text","text":" "},{"text":"You can then call the ","type":"text"},{"code":"finalizeIfNeeded","type":"codeVoice"},{"text":" on the component, dismiss the component’s view controller in the completion callback and display an error message.","type":"text"}]},{"code":["func didOpenExternalApplication(component: DropInComponent)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}]},{"type":"heading","text":"Handling an action","anchor":"Handling-an-action","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":"."}]},{"level":3,"text":"Receiving redirect","type":"heading","anchor":"Receiving-redirect"},{"inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent"},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"references":{"doc://Adyen/documentation/Adyen/RedirectComponent":{"navigatorTitle":[{"kind":"identifier","text":"RedirectComponent"}],"title":"RedirectComponent","abstract":[{"type":"text","text":"Handles any redirect Url whether its a web url, an App custom scheme url, or an app universal link."}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/adyen\/redirectcomponent","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedirectComponent"}]},"doc://Adyen/documentation/Adyen":{"type":"topic","url":"\/documentation\/adyen","title":"Adyen","identifier":"doc:\/\/Adyen\/documentation\/Adyen","abstract":[],"kind":"symbol","role":"collection"},"doc://Adyen/documentation/Adyen/Environment":{"role":"symbol","url":"\/documentation\/adyen\/environment","title":"Environment","abstract":[{"type":"text","text":"Struct that defines the environment to retrieve resources from."}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Environment"}],"navigatorTitle":[{"text":"Environment","kind":"identifier"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment"},"doc://Adyen/documentation/Adyen/AdyenSession":{"role":"symbol","url":"\/documentation\/adyen\/adyensession","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenSession","kind":"identifier"}],"abstract":[{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"type":"text","text":" acts as the delegate for the checkout payment flow."},{"text":" ","type":"text"},{"type":"text","text":"It can handle the required steps internally such as "},{"type":"codeVoice","code":"\/payments"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/payment\/details"},{"text":" ","type":"text"},{"text":"calls and partial payment calls, then provide feedback","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"via "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference","isActive":true},{"text":" methods.","type":"text"}],"type":"topic","title":"AdyenSession","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","navigatorTitle":[{"text":"AdyenSession","kind":"identifier"}],"kind":"symbol"},"doc://Adyen/documentation/Adyen/DropInComponent":{"navigatorTitle":[{"text":"DropInComponent","kind":"identifier"}],"url":"\/documentation\/adyen\/dropincomponent","title":"DropInComponent","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","abstract":[{"text":"A component that handles the entire flow of payment selection and payment details entry.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"DropInComponent","kind":"identifier"}]},"AdvancedFlow.md":{"identifier":"AdvancedFlow.md","title":"Advanced Flow","url":"AdvancedFlow.md","type":"link","titleInlineContent":[{"text":"Advanced Flow","type":"text"}]},"doc://Adyen/documentation/Adyen/ApplePayComponent":{"kind":"symbol","type":"topic","url":"\/documentation\/adyen\/applepaycomponent","abstract":[{"text":"A component that handles Apple Pay payments.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"ApplePayComponent","kind":"identifier"}],"title":"ApplePayComponent","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ApplePayComponent"}]},"doc://Adyen/documentation/Adyen/AdyenContext":{"abstract":[{"type":"text","text":"A class that defines the behavior of the components in a payment flow."}],"type":"topic","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","kind":"symbol","role":"symbol","title":"AdyenContext","url":"\/documentation\/adyen\/adyencontext","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenContext","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"AdyenContext"}]},"doc://Adyen/documentation/Adyen/DokuComponent":{"url":"\/documentation\/adyen\/dokucomponent","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","role":"symbol","navigatorTitle":[{"text":"DokuComponent","kind":"identifier"}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DokuComponent"}],"title":"DokuComponent","kind":"symbol","abstract":[{"text":"A component that provides a form for Doku Wallet, Doku Alfamart, and Doku Indomaret  payments.","type":"text"}]},"doc://Adyen/documentation/Adyen/AdyenSessionDelegate":{"title":"AdyenSessionDelegate","kind":"symbol","url":"\/documentation\/adyen\/adyensessiondelegate","type":"topic","abstract":[{"type":"text","text":"Describes the methods a delegate of "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"text":" needs to implement.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenSessionDelegate","kind":"identifier"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","navigatorTitle":[{"kind":"identifier","text":"AdyenSessionDelegate"}],"role":"symbol"},"https://docs.adyen.com/development-resources/client-side-authentication":{"type":"link","title":"here","titleInlineContent":[{"type":"text","text":"here"}],"url":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"}}}