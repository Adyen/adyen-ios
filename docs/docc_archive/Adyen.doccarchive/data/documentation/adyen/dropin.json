{"metadata":{"role":"article","roleHeading":"Article","title":"DropIn","modules":[{"name":"Adyen"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"variants":[{"paths":["\/documentation\/adyen\/dropin"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"abstract":[{"text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the ","type":"text"},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" response, and handles the entire checkout flow under the hood for most of use cases."}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the simplified checkout flow with the "},{"type":"codeVoice","code":"\/sessions"},{"text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to ","type":"text"},{"identifier":"AdvancedFlow.md","type":"reference","isActive":true},{"type":"text","text":"."}]},{"text":"Setting up the Drop-in","type":"heading","level":2,"anchor":"Setting-up-the-Drop-in"},{"inlineContent":[{"type":"text","text":"All Components need an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext"},{"text":". An instance of ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Please read more "},{"type":"reference","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","isActive":true},{"type":"text","text":" about the client key and how to get one."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Environment.test"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"overridingTitle":"live environments","type":"reference","overridingTitleInlineContent":[{"text":"live environments","type":"text"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"We recommend creating a new context for each payment attempt."}]},{"syntax":"swift","type":"codeListing","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"]},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"text":" with the response you received from the ","type":"text"},{"type":"codeVoice","code":"\/sessions"},{"text":" call and the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext"},{"type":"text","text":" instance."}]},{"syntax":"swift","type":"codeListing","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"]},{"inlineContent":[{"text":"Call the static ","type":"text"},{"type":"codeVoice","code":"initialize"},{"text":" function of the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"]},{"inlineContent":[{"type":"text","text":"Create a configuration object for "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true,"type":"reference"},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}],"type":"paragraph"},{"code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some payment methods need additional configuration. For example "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent"},{"type":"text","text":". These payment method specific configuration parameters can be set in an instance of "},{"code":"DropInComponent.Configuration","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Also for voucher payment methods like Doku variants, in order for the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","isActive":true},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"type":"text","text":" key in the application "},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Presenting the Drop-in","type":"heading","anchor":"Presenting-the-Drop-in"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"type":"text","text":" class and set the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"type":"text","text":" instance as the "},{"type":"codeVoice","code":"delegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"partialPaymentDelegate"},{"type":"text","text":" (if needed) of the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true,"type":"reference"},{"type":"text","text":" instance."}]},{"type":"codeListing","syntax":"swift","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""]},{"anchor":"Implementing-AdyenSessionDelegate","level":3,"type":"heading","text":"Implementing `AdyenSessionDelegate`"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference","isActive":true},{"text":". To handle the results of the Drop-in, the following methods of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"type":"text","text":" should be implemented:"}]},{"type":"codeListing","syntax":"swift","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"]},{"inlineContent":[{"type":"text","text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling "},{"type":"codeVoice","code":"finalizeIfNeeded"},{"text":" on the component.","type":"text"}],"type":"paragraph"},{"code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This method is invoked when an error occurred during the use of the Drop-in or the components.","type":"text"},{"type":"text","text":" "},{"text":"You can then call the ","type":"text"},{"type":"codeVoice","code":"finalizeIfNeeded"},{"type":"text","text":" on the component, dismiss the component’s view controller in the completion callback and display an error message."}]},{"syntax":"swift","code":["func didOpenExternalApplication(component: DropInComponent)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}]},{"text":"Handling an action","anchor":"Handling-an-action","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Receiving redirect","anchor":"Receiving-redirect","level":3},{"inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent"},{"text":" know when the user returns to your app. Do this by implementing the following in your ","type":"text"},{"code":"UIApplicationDelegate","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"],"type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Adyen\/documentation\/Adyen\/DropIn"},"references":{"https://docs.adyen.com/development-resources/client-side-authentication":{"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","type":"link","title":"here","titleInlineContent":[{"text":"here","type":"text"}],"url":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"},"doc: