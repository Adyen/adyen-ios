ode":"\/payment\/details","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"calls and partial payment calls, then provide feedback"},{"text":" ","type":"text"},{"type":"text","text":"via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"text":" methods.","type":"text"}]},"doc://adyen.Adyen/documentation/Adyen/ApplePayComponent":{"url":"\/documentation\/adyen\/applepaycomponent","type":"topic","abstract":[{"text":"A component that handles Apple Pay payments.","type":"text"}],"title":"ApplePayComponent","kind":"symbol","role":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ApplePayComponent"}],"navigatorTitle":[{"kind":"identifier","text":"ApplePayComponent"}]},"https://docs.adyen.com/development-resources/client-side-authentication":{"url":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","type":"link","title":"here","titleInlineContent":[{"type":"text","text":"here"}]},"doc://adyen.Adyen/documentation/Adyen/AdyenContext":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AdyenContext"}],"navigatorTitle":[{"text":"AdyenContext","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"text":"A class that defines the behavior of the components in a payment flow.","type":"text"}],"url":"\/documentation\/adyen\/adyencontext","title":"AdyenContext"}}}