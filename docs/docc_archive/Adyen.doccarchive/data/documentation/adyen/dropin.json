.","type":"text"},{"type":"text","text":" "},{"text":"It can handle the required steps internally such as ","type":"text"},{"type":"codeVoice","code":"\/payments"},{"text":" and ","type":"text"},{"code":"\/payment\/details","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"calls and partial payment calls, then provide feedback"},{"type":"text","text":" "},{"type":"text","text":"via "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true,"type":"reference"},{"type":"text","text":" methods."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AdyenSession"}],"kind":"symbol","title":"AdyenSession","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenSession","kind":"identifier"}]},"https://docs.adyen.com/development-resources/client-side-authentication":{"type":"link","titleInlineContent":[{"text":"here","type":"text"}],"url":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","title":"here"},"doc://adyen.Adyen/documentation/Adyen/DokuComponent":{"title":"DokuComponent","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"DokuComponent","kind":"identifier"}],"type":"topic","abstract":[{"text":"A component that provides a form for Doku Wallet, Doku Alfamart, and Doku Indomaret  payments.","type":"text"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"DokuComponent","kind":"identifier"}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","url":"\/documentation\/adyen\/dokucomponent"}}}