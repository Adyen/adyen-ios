{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"If the simplified checkout flow with the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to ","type":"text"},{"identifier":"AdvancedFlow.md","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"anchor":"Setting-up-the-Drop-in","level":2,"type":"heading","text":"Setting up the Drop-in"},{"inlineContent":[{"text":"All Components need an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},{"type":"text","text":". An instance of "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","type":"reference","isActive":true},{"type":"text","text":" wraps your client key, environment, payment, analytics configuration and so on."},{"type":"text","text":" "},{"type":"text","text":"Please read more "},{"type":"reference","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","isActive":true},{"type":"text","text":" about the client key and how to get one."}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Environment.test"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Environment","isActive":true,"overridingTitle":"live environments"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"We recommend creating a new context for each payment attempt."}],"type":"paragraph"},{"type":"codeListing","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"AdyenSession.Configuration"},{"type":"text","text":" with the response you received from the "},{"type":"codeVoice","code":"\/sessions"},{"text":" call and the ","type":"text"},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","isActive":true},{"text":" instance.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"]},{"type":"paragraph","inlineContent":[{"text":"Call the static ","type":"text"},{"code":"initialize","type":"codeVoice"},{"type":"text","text":" function of the "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"type":"text","text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance."}]},{"syntax":"swift","type":"codeListing","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a configuration object for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent"},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""]},{"inlineContent":[{"text":"Some payment methods need additional configuration. For example ","type":"text"},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","isActive":true},{"text":". These payment method specific configuration parameters can be set in an instance of ","type":"text"},{"code":"DropInComponent.Configuration","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"]},{"inlineContent":[{"text":"Also for voucher payment methods like Doku variants, in order for the ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","isActive":true,"type":"reference"},{"type":"text","text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the "},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"text":" key in the application ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","anchor":"Presenting-the-Drop-in","level":2,"text":"Presenting the Drop-in"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize the "},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","type":"reference"},{"text":" class and set the ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"type":"text","text":" instance as the "},{"type":"codeVoice","code":"delegate"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"partialPaymentDelegate"},{"text":" (if needed) of the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent"},{"type":"text","text":" instance."}]},{"type":"codeListing","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""],"syntax":"swift"},{"text":"Implementing `AdyenSessionDelegate`","anchor":"Implementing-AdyenSessionDelegate","type":"heading","level":3},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"text":". To handle the results of the Drop-in, the following methods of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"type":"text","text":" should be implemented:"}],"type":"paragraph"},{"type":"thematicBreak"},{"syntax":"swift","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"type":"codeListing"},{"inlineContent":[{"text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling ","type":"text"},{"type":"codeVoice","code":"finalizeIfNeeded"},{"type":"text","text":" on the component."}],"type":"paragraph"},{"type":"thematicBreak"},{"syntax":"swift","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"type":"codeListing"},{"inlineContent":[{"text":"This method is invoked when an error occurred during the use of the Drop-in or the components.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"You can then call the "},{"type":"codeVoice","code":"finalizeIfNeeded"},{"text":" on the component, dismiss the component’s view controller in the completion callback and display an error message.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"code":["func didOpenExternalApplication(component: DropInComponent)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}]},{"type":"thematicBreak"},{"type":"heading","text":"Handling an action","level":2,"anchor":"Handling-an-action"},{"type":"paragraph","inlineContent":[{"text":"Actions are handled by the Drop-in via its delegate ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"text":".","type":"text"}]},{"anchor":"Receiving-redirect","type":"heading","text":"Receiving redirect","level":3},{"inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent","type":"reference"},{"text":" know when the user returns to your app. Do this by implementing the following in your ","type":"text"},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"]}]}],"abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"code":"\/sessions","type":"codeVoice"},{"text":" response, and handles the entire checkout flow under the hood for most of use cases.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropIn"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/dropin"]}],"metadata":{"title":"DropIn","modules":[{"name":"Adyen"}],"role":"article","roleHeading":"Article"},"references":{"doc://adyen.Adyen/documentation/Adyen/DropInComponent":{"url":"\/documentation\/adyen\/dropincomponent","role":"symbol","title":"