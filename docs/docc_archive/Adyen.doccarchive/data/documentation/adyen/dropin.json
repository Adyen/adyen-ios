{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Adyen\/documentation\/Adyen\/DropIn"},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Adyen"}],"title":"DropIn"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"If the simplified checkout flow with the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to "},{"type":"reference","identifier":"AdvancedFlow.md","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Setting-up-the-Drop-in","level":2,"text":"Setting up the Drop-in","type":"heading"},{"inlineContent":[{"type":"text","text":"All Components need an "},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","type":"reference"},{"type":"text","text":". An instance of "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"text":" ","type":"text"},{"text":"Please read more ","type":"text"},{"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","isActive":true,"type":"reference"},{"type":"text","text":" about the client key and how to get one."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Environment.test"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Environment","isActive":true,"overridingTitle":"live environments","type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"We recommend creating a new context for each payment attempt.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"type":"text","text":" with the response you received from the "},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" call and the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenContext","type":"reference","isActive":true},{"text":" instance.","type":"text"}]},{"syntax":"swift","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"],"type":"codeListing"},{"inlineContent":[{"text":"Call the static ","type":"text"},{"type":"codeVoice","code":"initialize"},{"type":"text","text":" function of the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Create a configuration object for ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"text":". Check specific payment method pages to confirm if you need to include additional required parameters.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""]},{"inlineContent":[{"text":"Some payment methods need additional configuration. For example ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/ApplePayComponent","isActive":true,"type":"reference"},{"type":"text","text":". These payment method specific configuration parameters can be set in an instance of "},{"type":"codeVoice","code":"DropInComponent.Configuration"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"]},{"inlineContent":[{"type":"text","text":"Also for voucher payment methods like Doku variants, in order for the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DokuComponent","isActive":true,"type":"reference"},{"type":"text","text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the "},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"type":"text","text":" key in the application "},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Presenting the Drop-in","type":"heading","anchor":"Presenting-the-Drop-in","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"type":"text","text":" class and set the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" instance as the "},{"code":"delegate","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"partialPaymentDelegate"},{"text":" (if needed) of the ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/DropInComponent","isActive":true,"type":"reference"},{"type":"text","text":" instance."}]},{"syntax":"swift","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""],"type":"codeListing"},{"anchor":"Implementing-AdyenSessionDelegate","level":3,"text":"Implementing `AdyenSessionDelegate`","type":"heading"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"type":"text","text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"type":"text","text":". To handle the results of the Drop-in, the following methods of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"type":"text","text":" should be implemented:"}]},{"syntax":"swift","type":"codeListing","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"]},{"inlineContent":[{"text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling ","type":"text"},{"type":"codeVoice","code":"finalizeIfNeeded"},{"text":" on the component.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is invoked when an error occurred during the use of the Drop-in or the components."},{"text":" ","type":"text"},{"type":"text","text":"You can then call the "},{"code":"finalizeIfNeeded","type":"codeVoice"},{"type":"text","text":" on the component, dismiss the component’s view controller in the completion callback and display an error message."}]},{"code":["func didOpenExternalApplication(component: DropInComponent)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}],"type":"paragraph"},{"anchor":"Handling-an-action","text":"Handling an action","type":"heading","level":2},{"inlineContent":[{"text":"Actions are handled by the Drop-in via its delegate ","type":"text"},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Receiving-redirect","text":"Receiving redirect"},{"inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/RedirectComponent","isActive":true},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"]}]}],"abstract":[{"type":"text","text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the "},{"type":"codeVoice","code":"\/sessions"},{"type":"text","text":" response, and handles the entire checkout flow under the hood for most of use cases."}],"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"kind":"article","variants":[{"paths":["\/documentation\/adyen\/dropin"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Adyen/documentation/Adyen/DokuComponent":{"type":"topic","url":"\/documentation\/adyen\/dokucomponent","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"DokuComponent","kind":"identifier"}],"title":"DokuComponent","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"DokuComponent","kind":"id