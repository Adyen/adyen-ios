{"abstract":[{"text":"Both the Drop-in and the Components offer a an option to customize the strings to match the usecase \/ tone of voice your app.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/localization"]}],"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","interfaceLanguage":"swift"},"kind":"article","sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Adyen"}],"title":"Localization"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"By default, the SDK attempts to use a device’s locale for translation of text and formatting of monetary values. If the preferred device’s locales are not supported, the SDK falls back to the "},{"inlineContent":[{"type":"text","text":"en-US"}],"type":"strong"},{"text":" locale.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Localization only picks up locales that are listed in the "},{"type":"codeVoice","code":"CFBundleLocalizations"},{"type":"text","text":" property of your app’s "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" file."}]}]},{"level":2,"type":"heading","text":"Overriding default formatting of monetary values","anchor":"Overriding-default-formatting-of-monetary-values"},{"inlineContent":[{"text":"To enforce your own formatting for monetary values, use the ","type":"text"},{"code":"locale","type":"codeVoice"},{"text":" property on ","type":"text"},{"type":"codeVoice","code":"LocalizationParameters"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Overriding-a-string","text":"Overriding a string"},{"type":"paragraph","inlin