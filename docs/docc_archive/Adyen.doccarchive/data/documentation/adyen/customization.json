{"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/adyen\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Adyen"}],"title":"Customization"},"sections":[],"primaryContentSections":[{"content":[{"text":"Localization","anchor":"Localization","level":2,"type":"heading"},{"inlineContent":[{"text":"To customize strings, see: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Styling","text":"Styling"},{"inlineContent":[{"type":"text","text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:"}],"type":"paragraph"},{"tabs":[{"title":"Drop-in","content":[{"code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"type":"codeListing","syntax":"swift"}]},{"title":"Components","content":[{"type":"codeListing","syntax":"swift","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"]}]}],"type":"tabNavigator"},{"anchor":"Custom-Payment-Method-Display-Information","text":"Custom Payment Method Display Information","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following examples provide custom information to show for a specific payment method"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"syntax":"swift","type":"codeListing"},{"syntax":"swift","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"]}]},{"content":[{"inlineContent":[{"type":"text","text":"For components you can either set the "},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"type":"strong","inlineContent":[{"type":"text","text":"Drop-In"}]},{"type":"text","text":"."}],"type":"paragraph"},{"code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"type":"codeListing","syntax":"swift"}],"title":"Components"}]},{"inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Adyen/documentation/Adyen":{"url":"\/documentation\/adyen","type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/Adyen\/documentation\/Adyen","kind":"symbol","title":"Adyen"},"doc://Adyen/documentation/Adyen/API-Reference":{"title":"API Reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","url":"\/documentation\/adyen\/api-reference","kind":"article","type":"topic","abstract":[{"text":"The Adyen DropIn\/Components SDK API Reference.","type":"text"}],"role":"article"},"doc://Adyen/documentation/Adyen/Localization":{"title":"Localization","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a an option to customize the strings to match the usecase \/ tone of voice your app."}],"url":"\/documentation\/adyen\/localization","role":"article","type":"topic","kind":"article"}}}