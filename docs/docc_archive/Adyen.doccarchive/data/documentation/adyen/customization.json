{"abstract":[{"text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Localization","type":"heading","anchor":"Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To customize strings, see: "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","isActive":true},{"type":"text","text":"."}]},{"level":2,"text":"Styling","type":"heading","anchor":"Styling"},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"tabs":[{"content":[{"type":"codeListing","syntax":"swift","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"]}],"title":"Drop-in"},{"content":[{"type":"codeListing","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"syntax":"swift"}],"title":"Components"}],"type":"tabNavigator"},{"level":2,"text":"Custom Payment Method Display Information","type":"heading","anchor":"Custom-Payment-Method-Display-Information"},{"type":"paragraph","inlineContent":[{"text":"The following examples provide custom information to show for a specific payment method","type":"text"}]},{"tabs":[{"title":"Drop-in","content":[{"type":"codeListing","syntax":"swift","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"]},{"type":"codeListing","syntax":"swift","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}]},{"type":"codeListing","syntax":"swift","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"]}]},{"title":"Components","content":[{"type":"paragraph","inlineContent":[{"text":"For components you can either set the ","type":"text"},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"text":" directly before creating the component or use the same approach as with ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Drop-In"}]},{"text":".","type":"text"}]},{"syntax":"swift","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"type":"codeListing"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a full list of customization options can be found in the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","isActive":true},{"type":"text","text":"."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"kind":"article","metadata":{"title":"Customization","modules":[{"name":"Adyen"}],"role":"article","roleHeading":"Article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization"},"sections":[],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"references":{"doc://adyen.Adyen/documentation/Adyen":{"kind":"symbol","abstract":[],"title":"Adyen","type":"topic","role":"collection","url":"\/documentation\/adyen","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen"},"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","abstract":[{"text":"The Adyen DropIn\/Components SDK API Reference.","type":"text"}],"url":"\/documentation\/adyen\/api-reference","role":"article","title":"API Reference","kind":"article"},"doc://adyen.Adyen/documentation/Adyen/Localization":{"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","title":"Localization","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"code":"LocalizationParameters","type":"codeVoice"},{"text":" object. You can configure these settings for both the Drop-in and individual Components through their ","type":"text"},{"code":"configuration.localizationParameters","type":"codeVoice"},{"text":" property.","type":