{"abstract":[{"text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app.","type":"text"}],"kind":"article","sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Localization","level":2,"text":"Localization"},{"inlineContent":[{"type":"text","text":"To customize strings, see: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Styling","level":2,"anchor":"Styling"},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"type":"codeListing","syntax":"swift"}]},{"title":"Components","content":[{"syntax":"swift","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"type":"codeListing"}]}]},{"anchor":"Custom-Payment-Method-Display-Information","level":2,"text":"Custom Payment Method Display Information","type":"heading"},{"inlineContent":[{"type":"text","text":"The following examples provide custom information to show for a specific payment method"}],"type":"paragraph"},{"tabs":[{"title":"Drop-in","content":[{"type":"codeListing","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"syntax":"swift"},{"type":"codeListing","syntax":"swift","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}]},{"code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"syntax":"swift","type":"codeListing"}]},{"title":"Components","content":[{"inlineContent":[{"type":"text","text":"For components you can either set the "},{"code":"merchantProvidedDisplayInformation","type":"codeVoice"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"type":"strong","inlineContent":[{"text":"Drop-In","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"]}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference"},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/adyen\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"metadata":{"modules":[{"name":"Adyen"}],"roleHeading":"Article","role":"article","title":"Customization"},"references":{"doc://Adyen/documentation/Adyen/API-Reference":{"kind":"article","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","title":"API Reference","role":"article","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}],"type":"topic","url":"\/documentation\/adyen\/api-reference"},"doc://Adyen/documentation/Adyen/Localization":{"title":"Localization","kind":"article","type":"topic","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","url":"\/documentation\/adyen\/localization","abstract":[{"type":"text","text":"The SDK allows you to customize UI strings and manage locale behavior using the "},{"code":"LocalizationParameters","type":"codeVoice"},{"type":"text","text":" object. You can configure these settings for both the Drop-in and individual Components through their "},{"code":"configuration.localizationParameters","type":"codeVoice"},{"type":"text","text":" property."}],"role":"article"},"doc://Adyen/documentation/Adyen":{"type":"topic","kind":"symbol","url":"\/documentation\/adyen","role":"collection","identifier":"doc:\/\/Adyen\/documentation\/Adyen","title":"Adyen","abstract":[]}}}