{"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Localization","text":"Localization","level":2},{"type":"paragraph","inlineContent":[{"text":"To customize strings, see: ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Styling","text":"Styling","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"syntax":"swift","type":"codeListing","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"]}]},{"title":"Components","content":[{"type":"codeListing","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"syntax":"swift"}]}]},{"type":"heading","anchor":"Custom-Payment-Method-Display-Information","text":"Custom Payment Method Display Information","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following examples provide custom information to show for a specific payment method"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}]},{"code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"type":"codeListing","syntax":"swift"}]},{"title":"Components","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For components you can either set the "},{"code":"merchantProvidedDisplayInformation","type":"codeVoice"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"type":"strong","inlineContent":[{"type":"text","text":"Drop-In"}]},{"type":"text","text":"."}]},{"code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"type":"codeListing","syntax":"swift"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a full list of customization options can be found in the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","isActive":true},{"type":"text","text":"."}]}]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Adyen"}],"title":"Customization"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"references":{"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"type":"topic","title":"API Reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","kind":"article","role":"article","url":"\/documentation\/adyen\/api-reference","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}]},"doc://adyen.Adyen/documentation/Adyen/Localization":{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","kind":"article","title":"Localization","abstract":[{"type":"text","text":"The SDK allows you to customize UI strings and manage locale behavior using the "},{"type":"codeVoice","code":"LocalizationParameters"},{"type":"text","text":" object. You can configure these settings for both the Drop-in and individual Components through their "},{"type":"codeVoice","code":"configuration.localizationParameters"},{"type":"text","text":" property."}],"type":"topic","url":"\/documentation\/adyen\/localization","role":"article"},"doc://adyen.Adyen/documentation/Adyen":{"role":"collection","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","type":"topic","url":"\/documentation\