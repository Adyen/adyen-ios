{"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Localization","level":2,"anchor":"Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To customize strings, see: "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","isActive":true},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Styling","text":"Styling"},{"inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}],"type":"paragraph"},{"type":"tabNavigator","tabs":[{"content":[{"type":"codeListing","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"syntax":"swift"}],"title":"Drop-in"},{"title":"Components","content":[{"code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"],"type":"codeListing","syntax":"swift"}]}]},{"anchor":"Custom-Payment-Method-Display-Information","level":2,"text":"Custom Payment Method Display Information","type":"heading"},{"inlineContent":[{"text":"The following examples provide custom information to show for a specific payment method","type":"text"}],"type":"paragraph"},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"type":"codeListing","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"To override the display information for stored payment methods use:"}],"type":"paragraph"},{"type":"codeListing","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"syntax":"swift"}]},{"title":"Components","content":[{"inlineContent":[{"text":"For components you can either set the ","type":"text"},{"code":"merchantProvidedDisplayInformation","type":"codeVoice"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"inlineContent":[{"text":"Drop-In","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"],"syntax":"swift","type":"codeListing"}]}]},{"inlineContent":[{"type":"text","text":"For a full list of customization options can be found in the "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"metadata":{"title":"Customization","role":"article","roleHeading":"Article","modules":[{"name":"Adyen"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Adyen\/documentation\/Adyen\/Customization"},"sections":[],"references":{"doc://Adyen/documentation/Adyen":{"kind":"symbol","title":"Adyen","abstract":[],"type":"topic","url":"\/documentation\/adyen","identifier":"doc:\/\/Adyen\/documentation\/Adyen","role":"collection"},"doc://Adyen/documentation/Adyen/Localization":{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","kind":"article","title":"Localization","role":"article","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"code":"LocalizationParameters","type":"codeVoice"},{"type":"text","text":" object. You can configure these settings for both the Drop-in and individual Components through their "},{"type":"codeVoice","code":"configuration.localizationParameters"},{"type":"text","text":" property."}],"type":"topic","url":"\/documentation\/adyen\/localization"},"doc://Adyen/documentation/Adyen/API-Reference":{"type":"topic","role":"article","title":"API Reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}],"url":"\/documentation\/adyen\/api-reference","kind":"article"}}}