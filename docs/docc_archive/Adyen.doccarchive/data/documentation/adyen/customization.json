{"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen"]]},"primaryContentSections":[{"content":[{"text":"Localization","level":2,"anchor":"Localization","type":"heading"},{"inlineContent":[{"type":"text","text":"To customize strings, see: "},{"type":"reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Styling","level":2,"anchor":"Styling","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For example, to change the section header titles and form field titles in the Drop-in to red, and turn the submit button’s background to black with white foreground:","type":"text"}]},{"type":"tabNavigator","tabs":[{"content":[{"type":"codeListing","code":["var style = DropInComponent.Style()","style.listComponent.sectionHeader.title.color = .red","style.formComponent.textField.title.color = .red","style.formComponent.mainButtonItem.button.backgroundColor = .black","style.formComponent.mainButtonItem.button.title.color = .white","","let configuration = DropInComponent.Configuration(style: style)","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: configuration)"],"syntax":"swift"}],"title":"Drop-in"},{"content":[{"type":"codeListing","syntax":"swift","code":["var style = FormComponentStyle()","style.backgroundColor = .black","style.header.title.color = .white","style.textField.title.color = .white","style.textField.text.color = .white","style.switch.title.color = .white","","let config = CardComponent.Configuration(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"]}],"title":"Components"}]},{"anchor":"Custom-Payment-Method-Display-Information","text":"Custom Payment Method Display Information","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The following examples provide custom information to show for a specific payment method","type":"text"}]},{"type":"tabNavigator","tabs":[{"title":"Drop-in","content":[{"code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"type":"codeListing","syntax":"swift"},{"syntax":"swift","code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"To override the display information for stored payment methods use:","type":"text"}]},{"code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"type":"codeListing","syntax":"swift"}]},{"title":"Components","content":[{"inlineContent":[{"text":"For components you can either set the ","type":"text"},{"type":"codeVoice","code":"merchantProvidedDisplayInformation"},{"text":" directly before creating the component or use the same approach as with ","type":"text"},{"inlineContent":[{"text":"Drop-In","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["cardPaymentMethod.merchantProvidedDisplayInformation = .init(","    title: \"Custom Card Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a full list of customization options can be found in the "},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Adyen"}],"title":"Customization"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"references":{"doc://Adyen/documentation/Adyen/API-Reference":{"role":"article","title":"API Reference","url":"\/documentation\/adyen\/api-reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","type":"topic","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}],"kind":"article"},"doc://Adyen/documentation/Adyen/Localization":{"title":"Localization","abstract":[{"text":"Both the Drop-in and the Components offer a an option to customize the strings to match the usecase \/ tone of voice your app.","type":"text"}],"kind":"article","type":"topic","role":"article","url":"\/documentation\/adyen\/localization","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization"},"doc://Adyen/documentation/Adyen":{"type":"topic","url":"\/documentation\/adyen","title":"Adyen","identifier":"doc:\/\/Adyen\/documentation\/Adyen","abstract":[],"kind":"symbol","role":"collection"}}}