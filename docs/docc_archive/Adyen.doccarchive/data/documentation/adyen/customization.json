Title\"",")","","let component = CardComponent(","    paymentMethod: cardPaymentMethod,","    context: context,","    configuration: config",")"]}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"For a full list of customization options can be found in the ","type":"text"},{"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Customization","roleHeading":"Article","role":"article","modules":[{"name":"Adyen"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/customization"]}],"sections":[],"identifier":{"url":"doc:\/\/Adyen\/documentation\/Adyen\/Customization","interfaceLanguage":"swift"},"references":{"doc://Adyen/documentation/Adyen/API-Reference":{"type":"topic","title":"API Reference","identifier":"doc:\/\/Adyen\/documentation\/Adyen\/API-Reference","role":"article","kind":"article","url":"\/documentation\/adyen\/api-reference","abstract":[{"type":"text","text":"The Adyen DropIn\/Components SDK API Reference."}]},"doc://Adyen/documentation/Adyen":{"role":"collection","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/adyen","identifier":"doc:\/\/Adyen\/documentation\/Adyen","title":"Adyen"},"doc://Adyen/documentation/Adyen/Localization":{"abstract":[{"type":"text","text":"The SDK allows you to customize UI strings and manage locale behavior using the "},{"code":"LocalizationParameters","type":"codeVoice"},{"type":"text","text":" object. You can configure these settings for both the Drop-in and individual Components through their "},{"type":"codeVoice","code":"configuration.localizationParameters"},{"type":"text","text":" property."}],"identifier":"doc:\/\/Adyen\/documentation\/Adyen\/Localization","url":"\/documentation\/adyen\/localization","role":"article","kind":"article","title":"Localization","type":"topic"}}}