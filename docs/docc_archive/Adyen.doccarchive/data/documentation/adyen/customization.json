syntax":"swift"}],"title":"Components"}]},{"inlineContent":[{"type":"text","text":"For a full list of customization options can be found in the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/API-Reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"Adyen"}],"title":"Customization","role":"article","roleHeading":"Article"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Both the Drop-in and the Components offer a number of customization options to allow you to match the appearance of your app."}],"variants":[{"paths":["\/documentation\/adyen\/customization"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"references":{"doc://adyen.Adyen/documentation/Adyen/Localization":{"url":"\/documentation\/adyen\/localization","kind":"article","role":"article","title":"Localization","abstract":[{"text":"The SDK allows you to customize UI strings and manage locale behavior using the ","type":"text"},{"code":"LocalizationParameters","type":"codeVoice"},{"type":"text","text":" object. You can configure these settings for both the Drop-in and individual Components through their "},{"type":"codeVoice","code":"configuration.localizationParameters"},{"text":" property.","type":"text"}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Localization","type":"topic"},"doc://adyen.Adyen/documentation/Adyen":{"type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","kind":"symbol","title":"Adyen","url":"\/documentation\/adyen"},"doc://adyen.Adyen/documentation/Adyen/API-Reference":{"role":"article","kind":"article","title":"API Reference","abstract":[{"text":"The Adyen DropIn\/Components SDK API Reference.","type":"text"}],"type":"topic","url":"\/documentation\/adyen\/api-reference","identifier":"doc: