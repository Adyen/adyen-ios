n(style: style)","let component = CardComponent(paymentMethod: paymentMethod,","                              context: context,","                              configuration: config)"]}]}],"type":"tabNavigator"},{"text":"Custom Payment Method Display Information","anchor":"Custom-Payment-Method-Display-Information","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The following examples provide custom information to show for a specific payment method"}],"type":"paragraph"},{"tabs":[{"content":[{"syntax":"swift","code":["\/\/ Override the (regular) payment method of type `.scheme` with custom display information","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .scheme,","    with: .init(","        title: \"Custom Cards title\",","        subtitle: \"Custom Cards description\"","    )",")"],"type":"codeListing"},{"code":["\/\/ Override the (regular) `.giftcard` payment method if the brand is \"genericgiftcard\"","paymentMethods.overrideDisplayInformation(","    ofRegularPaymentMethod: .giftcard,","    with: .init(","        title: \"Custom Giftcard title\",","        subtitle: \"Custom Giftcard subtitle\"","        ),","    where: { (paymentMethod: GiftCardPaymentMethod) -> Bool in","        paymentMethod.brand == \"genericgiftcard\"","    }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"To override the display information for stored payment methods use:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["paymentMethods.overrideDisplayInformation(","    ofStoredPaymentMethod: ...",")"],"syntax":"swift"}],"title":"Drop-in"},{"title":"Components","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For components you can either set the "},{"code":"merchantProvidedDisplayInformation","type":"codeVoice"},{"type":"text","text":" directly before creating the component or use the same approach as with "},{"type":"strong","inlineContent":[{"text":"Drop-In","type":"text"}]},