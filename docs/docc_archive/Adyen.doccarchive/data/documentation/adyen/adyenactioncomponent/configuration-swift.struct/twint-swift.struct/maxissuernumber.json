{"metadata":{"title":"maxIssuerNumber","role":"symbol","externalID":"s:5Adyen0A15ActionComponentC13ConfigurationV5TwintV15maxIssuerNumberSivp","symbolKind":"property","modules":[{"name":"Adyen"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxIssuerNumber","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"roleHeading":"Instance Property"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS"],"tokens":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"maxIssuerNumber","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"content":[{"inlineContent":[{"type":"text","text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed."},{"text":" ","type":"text"},{"text":"For this to work, ","type":"text"},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"text":" must include “twint-extended”.","type":"text"},{"type":"text","text":" "},{"text":"If you configure any ","type":"text"},{"code":"maxIssuerNumber","type":"codeVoice"},{"type":"text","text":" below 39, the result will always contain all apps above "},{"type":"codeVoice","code":"maxIssuerNumber"},{"text":" ","type":"text"},{"type":"text","text":"up to and including 39, even if none of them are installed."},{"type":"text","text":" "},{"type":"text","text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing."}],"type":"paragraph"}],"name":"Important","type":"aside","style":"important"}]}],"kind":"symbol","abstract":[{"text":"The issuer number of the highest scheme you listed under ","type":"text"},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"type":"text","text":"."},{"type":