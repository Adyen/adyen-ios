{"sections":[],"metadata":{"externalID":"s:5Adyen0A15ActionComponentC13ConfigurationV5TwintV15maxIssuerNumberSivp","modules":[{"name":"Adyen"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"maxIssuerNumber"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"symbolKind":"property","roleHeading":"Instance Property","title":"maxIssuerNumber","role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"maxIssuerNumber","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed."},{"text":" ","type":"text"},{"type":"text","text":"For this to work, "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"text":" must include “twint-extended”.","type":"text"},{"text":" ","type":"text"},{"text":"If you configure any ","type":"text"},{"type":"codeVoice","code":"maxIssuerNumber"},{"type":"text","text":" below 39, the result will always contain all apps above "},{"code":"maxIssuerNumber","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"up to and including 39, even if none of them are installed."},{"type":"text","text":" "},{"text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Adyen\/documentation\/Adyen","doc:\/\/Adyen\/documentation\/Adyen\/AdyenActionComponent","doc: