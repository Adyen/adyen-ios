{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"The issuer number of the highest scheme you listed under ","type":"text"},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"type":"text","text":" "},{"text":"The value is clamped between 0 and 39.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"platforms":["iOS"],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed."},{"type":"text","text":" "},{"type":"text","text":"For this to work, "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":" must include “twint-extended”."},{"type":"text","text":" "},{"type":"text","text":"If you configure any "},{"code":"maxIssuerNumber","type":"codeVoice"},{"text":" below 39, the result will always contain all apps above ","type":"text"},{"code":"maxIssuerNumber","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"up to and including 39, even if none of them are installed."},{"type":"text","text":" "},{"type":"text","text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing."}]}],"style":"important"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/adyen\/adyenactioncomponent\/configuration-swift.struct\/twint-swift.struct\/maxissuernumber"],"traits":[{"interfaceLanguag