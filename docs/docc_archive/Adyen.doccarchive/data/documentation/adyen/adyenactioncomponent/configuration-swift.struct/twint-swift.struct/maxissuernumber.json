{"identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct\/Twint-swift.struct\/maxIssuerNumber","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxIssuerNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"content":[{"inlineContent":[{"type":"text","text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed."},{"type":"text","text":" "},{"type":"text","text":"For this to work, "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":" must include “twint-extended”."},{"type":"text","text":" "},{"type":"text","text":"If you configure any "},{"type":"codeVoice","code":"maxIssuerNumber"},{"type":"text","text":" below 39, the result will always contain all apps above "},{"type":"codeVoice","code":"maxIssuerNumber"},{"type":"text","text":" "},{"type":"text","text":"up to and including 39, even if none of them are installed."},{"type":"text","text":" "},{"type":"text","text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing."}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"}],"kind":"content"}],"abstract":[{"type":"text","text":"The issuer number of the highest scheme you listed under "},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"type":"text","text":" "},{"type":"text","text":"The value is clamped between 0 and 39."}],"variants":[{"paths":["\/documentation\/adyen\/adyenactioncomponent\/configuration-swift.struct\/twint-swift.struct\/maxissuernumber"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Adyen"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxIssuerNumber","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"symbolKind":"property","roleHeading":"Instance Property","externalID":"s:5Adyen0A15ActionComponentC13ConfigurationV5TwintV15maxIssuerNumberSivp","role":"symbol","title":"maxIssuerNumber"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen","doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenActionComponent","doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct","doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenActionComponent\/Configuration-swift.struct\/Twint-swift.struct"]]},"kind":"symbol","sections":[],"references":{"doc://adyen.Adyen/documentation/Adyen/AdyenActionComponent":{"role":"symbol","abstract":[{"type":"text","text":"An action handler component to perform any supported action out of the box."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenActionComponent","kind":"identifier"}],"url":"\/documentation\/adyen\/adyenactioncomponent","title":"AdyenActionComponent","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenActionComponent","kind":"symbol","type":"topic","navigatorTitle":[{"text":"AdyenActionComponent","kind":"identifier"}]},"doc://adyen.Adyen/documentation/Adyen/AdyenActionComponent/Configuration-swift.struct":{"url":"\/documentation\/adyen\/adyenactioncomponent\/configuration-swift.struct","title":"AdyenActionComponent.Configuration","role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Configuration"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{