{"primaryContentSections":[{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"If the simplified checkout flow with the "},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to "},{"isActive":true,"identifier":"AdvancedFlow.md","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Setting-up-the-Drop-in","text":"Setting up the Drop-in","type":"heading"},{"inlineContent":[{"text":"All Components need an ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":". An instance of ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"text":" ","type":"text"},{"text":"Please read more ","type":"text"},{"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","isActive":true,"type":"reference"},{"text":" about the client key and how to get one.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"Environment.test","type":"codeVoice"},{"text":" during testing. When you’re ready to accept live payments, change the value to one of our ","type":"text"},{"overridingTitleInlineContent":[{"type":"text","text":"live environments"}],"overridingTitle":"live environments","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Environment","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"We recommend creating a new context for each payment attempt.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"text":" with the response you received from the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"text":" call and the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","type":"reference"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"],"type":"codeListing"},{"inlineContent":[{"text":"Call the static ","type":"text"},{"code":"initialize","type":"codeVoice"},{"text":" function of the ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true,"type":"reference"},{"text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Create a configuration object for "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","isActive":true},{"type":"text","text":". Check specific payment method pages to confirm if you need to include additional required parameters."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Some payment methods need additional configuration. For example "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","isActive":true},{"type":"text","text":". These payment method specific configuration parameters can be set in an instance of "},{"type":"codeVoice","code":"DropInComponent.Configuration"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"],"type":"codeListing"},{"inlineContent":[{"text":"Also for voucher payment methods like Doku variants, in order for the ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","type":"reference","isActive":true},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"type":"codeVoice","code":"NSPhotoLibraryAddUsageDescription"},{"text":" key in the application ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Presenting-the-Drop-in","text":"Presenting the Drop-in","type":"heading"},{"inlineContent":[{"text":"Initialize the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","type":"reference"},{"text":" class and set the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"text":" instance as the ","type":"text"},{"type":"codeVoice","code":"delegate"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"partialPaymentDelegate"},{"text":" (if needed) of the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","type":"reference"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""],"type":"codeListing"},{"level":3,"anchor":"Implementing-AdyenSessionDelegate","text":"Implementing `AdyenSessionDelegate`","type":"heading"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"type":"text","text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"type":"text","text":". To handle the results of the Drop-in, the following methods of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},{"type":"text","text":" should be implemented:"}],"type":"paragraph"},{"type":"thematicBreak"},{"syntax":"swift","code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling "},{"type":"codeVoice","code":"finalizeIfNeeded"},{"type":"text","text":" on the component."}],"type":"paragraph"},{"type":"thematicBreak"},{"syntax":"swift","code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This method is invoked when an error occurred during the use of the Drop-in or the components."},{"type":"text","text":" "},{"type":"text","text":"You can then call the "},{"type":"codeVoice","code":"finalizeIfNeeded"},{"type":"text","text":" on the component, dismiss the component’s view controller in the completion callback and display an error message."}],"type":"paragraph"},{"type":"thematicBreak"},{"syntax":"swift","code":["func didOpenExternalApplication(component: DropInComponent)"],"type":"codeListing"},{"inlineContent":[{"text":"This optional method is invoked after a redirect to an external application has occurred.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"anchor":"Handling-an-action","text":"Handling an action","type":"heading"},{"inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"anchor":"Receiving-redirect","text":"Receiving redirect","type":"heading"},{"inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent","isActive":true,"type":"reference"},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"],"type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"text":" response, and handles the entire checkout flow under the hood for most of use cases.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adyen\/dropin"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Adyen"}],"title":"DropIn"},"identifier":{"url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropIn","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"kind":"article","references":{"doc://adyen.Adyen/documentation/Adyen/AdyenSession":{"kind":"symbol","url":"\/documentation\/adyen\/adyensession","navigatorTitle":[{"text":"AdyenSession","kind":"identifier"}],"title":"AdyenSession","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenSession","kind":"identifier"}],"role":"symbol","abstract":[{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference"},{"text":" acts as the delegate for the checkout payment flow.","type":"text"},{"text":" ","type":"text"},{"text":"It can handle the required steps internally such as ","type":"text"},{"code":"\/payments","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"\/payment\/details","type":"codeVoice"},{"text":" ","type":"text"},{"text":"calls and partial payment calls, then provide feedback","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference"},{"text":" methods.","type":"text"}],"type":"topic"},"doc://adyen.Adyen/documentation/Adyen/RedirectComponent":{"url":"\/documentation\/adyen\/redirectcomponent","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Handles any redirect Url whether its a web url, an App custom scheme url, or an app universal link."}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent","role":"symbol","navigatorTitle":[{"text":"RedirectComponent","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RedirectComponent","kind":"identifier"}],"title":"RedirectComponent"},"doc://adyen.Adyen/documentation/Adyen/AdyenContext":{"title":"AdyenContext","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenContext","kind":"identifier"}],"navigatorTitle":[{"text":"AdyenContext","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A class that defines the behavior of the components in a payment flow."}],"kind":"symbol","url":"\/documentation\/adyen\/adyencontext","role":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext"},"doc://adyen.Adyen/documentation/Adyen/DokuComponent":{"abstract":[{"type":"text","text":"A component that provides a form for Doku Wallet, Doku Alfamart, and Doku Indomaret  payments."}],"kind":"symbol","url":"\/documentation\/adyen\/dokucomponent","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DokuComponent"}],"title":"DokuComponent","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DokuComponent"}]},"doc://adyen.Adyen/documentation/Adyen/AdyenSessionDelegate":{"kind":"symbol","abstract":[{"type":"text","text":"Describes the methods a delegate of "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"type":"text","text":" needs to implement."}],"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"AdyenSessionDelegate","kind":"identifier"}],"type":"topic","url":"\/documentation\/adyen\/adyensessiondelegate","title":"AdyenSessionDelegate","role":"symbol","navigatorTitle":[{"text":"AdyenSessionDelegate","kind":"identifier"}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate"},"https://docs.adyen.com/development-resources/client-side-authentication":{"title":"here","titleInlineContent":[{"type":"text","text":"here"}],"type":"link","url":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication"},"AdvancedFlow.md":{"title":"Advanced Flow","titleInlineContent":[{"text":"Advanced Flow","type":"text"}],"type":"link","url":"AdvancedFlow.md","identifier":"AdvancedFlow.md"},"doc://adyen.Adyen/documentation/Adyen/ApplePayComponent":{"abstract":[{"type":"text","text":"A component that handles Apple Pay payments."}],"role":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","navigatorTitle":[{"kind":"identifier","text":"ApplePayComponent"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ApplePayComponent"}],"url":"\/documentation\/adyen\/applepaycomponent","title":"ApplePayComponent","kind":"symbol","type":"topic"},"doc://adyen.Adyen/documentation/Adyen/DropInComponent":{"title":"DropInComponent","role":"symbol","url":"\/documentation\/adyen\/dropincomponent","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DropInComponent"}],"abstract":[{"type":"text","text":"A component that handles the entire flow of payment selection and payment details entry."}],"navigatorTitle":[{"kind":"identifier","text":"DropInComponent"}],"type":"topic","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","kind":"symbol"},"doc://adyen.Adyen/documentation/Adyen/Environment":{"url":"\/documentation\/adyen\/environment","type":"topic","title":"Environment","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Environment","navigatorTitle":[{"text":"Environment","kind":"identifier"}],"abstract":[{"type":"text","text":"Struct that defines the environment to retrieve resources from."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}],"kind":"symbol"},"doc://adyen.Adyen/documentation/Adyen":{"role":"collection","type":"topic","title":"Adyen","url":"\/documentation\/adyen","abstract":[],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen","kind":"symbol"}}}