{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"text","text":"The issuer number of the highest scheme you listed under "},{"type":"codeVoice","code":"LSApplicationQueriesSchemes"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"E.g. pass 39, if you listed all schemes from “twint-issuer1” up to and including “twint-issuer39”."},{"type":"text","text":" "},{"type":"text","text":"The value is clamped between 0 and 39."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxIssuerNumber","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"platforms":["iOS"],"languages":["swift"]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"All apps above “twint-issuer39” will always be returned if one of these apps is installed.","type":"text"},{"text":" ","type":"text"},{"text":"For this to work, ","type":"text"},{"code":"LSApplicationQueriesSchemes","type":"codeVoice"},{"text":" must include “twint-extended”.","type":"text"},{"text":" ","type":"text"},{"text":"If you configure any ","type":"text"},{"code":"maxIssuerNumber","type":"codeVoice"},{"text":" below 39, the result will always contain all apps above ","type":"text"},{"code":"maxIssuerNumber","type":"codeVoice"},{"text":" ","type":"text"},{"text":"up to and including 39, even if none of them are installed.","type":"text"},{"text":" ","type":"text"},{"text":"Additionally, if the fetch fails and the cache is empty, none of these apps will be found when probing.","type":"text"}]}]}],"kind":"content"}],"metadata":{"role":"symbol","roleHeading":"Instance Property","externalID":"s:5Adyen23TwintSDKActionComponentC13ConfigurationV15maxIssuerNumberSivp