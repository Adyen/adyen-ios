{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The Drop-in handles the presentation of available payment methods and the subsequent entry of a customer’s payment details. It is initialized with the payment methods of the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"text":" response, and handles the entire checkout flow under the hood for most of use cases.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/adyen.Adyen\/documentation\/Adyen"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"If the simplified checkout flow with the ","type":"text"},{"code":"\/sessions","type":"codeVoice"},{"text":" endpoint does not work for you, or you prefer to have more control over the whole flow, please refer to ","type":"text"},{"identifier":"AdvancedFlow.md","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Setting up the Drop-in","level":2,"anchor":"Setting-up-the-Drop-in","type":"heading"},{"inlineContent":[{"text":"All Components need an ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":". An instance of ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"text":" wraps your client key, environment, payment, analytics configuration and so on.","type":"text"},{"text":" ","type":"text"},{"text":"Please read more ","type":"text"},{"identifier":"https:\/\/docs.adyen.com\/development-resources\/client-side-authentication","isActive":true,"type":"reference"},{"text":" about the client key and how to get one.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Environment.test"},{"type":"text","text":" during testing. When you’re ready to accept live payments, change the value to one of our "},{"isActive":true,"type":"reference","overridingTitle":"live environments","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/Environment","overridingTitleInlineContent":[{"type":"text","text":"live environments"}]},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"We recommend creating a new context for each payment attempt."}],"type":"paragraph"},{"code":["var context: AdyenContext {","    let apiContext = try! APIContext(environment: componentsEnvironment, clientKey: clientKey)","    return AdyenContext(apiContext: apiContext,","                        payment: payment,","                        analyticsConfiguration: analyticsConfiguration)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"AdyenSession.Configuration","type":"codeVoice"},{"type":"text","text":" with the response you received from the "},{"code":"\/sessions","type":"codeVoice"},{"type":"text","text":" call and the "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenContext","isActive":true,"type":"reference"},{"type":"text","text":" instance."}],"type":"paragraph"},{"code":["let configuration = AdyenSession.Configuration(sessionIdentifier: response.sessionId,","                                               initialSessionData: response.sessionData,","                                               context: context)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Call the static ","type":"text"},{"code":"initialize","type":"codeVoice"},{"text":" function of the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"text":" by providing the configuration and the delegates, which will asynchronously create and return the session instance.","type":"text"}],"type":"paragraph"},{"code":["AdyenSession.initialize(with: configuration, delegate: self, presentationDelegate: self) { [weak self] result in","    switch result {","    case let .success(session):","        \/\/ store the session object","        self?.session = session","    case let .failure(error):","        \/\/ handle the error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Create a configuration object for ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent","type":"reference","isActive":true},{"text":". Check specific payment method pages to confirm if you need to include additional required parameters.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Check specific payment method pages to confirm if you need to configure additional required parameters.","let dropInConfiguration = DropInComponent.Configuration()","let component = DropInComponent(paymentMethods: paymentMethods,","                                context: context,","                                configuration: dropInConfiguration)",""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Some payment methods need additional configuration. For example "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/ApplePayComponent","type":"reference","isActive":true},{"type":"text","text":". These payment method specific configuration parameters can be set in an instance of "},{"type":"codeVoice","code":"DropInComponent.Configuration"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let summaryItems = [","                      PKPaymentSummaryItem(label: \"Item A\", amount: 75, type: .final),","                      PKPaymentSummaryItem(label: \"Item B\", amount: 25, type: .final),","                      PKPaymentSummaryItem(label: \"My Company\", amount: 100, type: .final)","                   ]","let applePayment = try ApplePayPayment(countryCode: \"US\",","                                       currencyCode: \"USD\",","                                       summaryItems: summaryItems)","","let dropInConfiguration = DropInComponent.Configuration()","dropInConfiguration.applePay = .init(payment: applePayment,","                               merchantIdentifier: \"merchant.com.adyen.MY_MERCHANT_ID\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Also for voucher payment methods like Doku variants, in order for the ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DokuComponent","isActive":true,"type":"reference"},{"text":" to enable the shopper to save the voucher, access to the shopper photos is requested, so a suitable text needs to be added to the ","type":"text"},{"code":"NSPhotoLibraryAddUsageDescription","type":"codeVoice"},{"text":" key in the application ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Presenting the Drop-in","level":2,"anchor":"Presenting-the-Drop-in","type":"heading"},{"inlineContent":[{"text":"Initialize the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent"},{"text":" class and set the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession"},{"text":" instance as the ","type":"text"},{"code":"delegate","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"partialPaymentDelegate","type":"codeVoice"},{"text":" (if needed) of the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropInComponent"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"code":["let dropInComponent = DropInComponent(paymentMethods: paymentMethods,","                                      context: context,","                                      configuration: dropInConfiguration)"," ","\/\/ Keep the Drop-in instance to avoid it being destroyed after the function is executed.","self.dropInComponent = dropInComponent"," ","\/\/ Set session as the delegate for Drop-in","dropInComponent.delegate = session","dropInComponent.partialPaymentDelegate = session"," ","present(dropInComponent.viewController, animated: true)",""],"type":"codeListing","syntax":"swift"},{"text":"Implementing `AdyenSessionDelegate`","level":3,"anchor":"Implementing-AdyenSessionDelegate","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"text":" makes the necessary calls to handle the whole flow and notifies your application through its delegate, ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference","isActive":true},{"text":". To handle the results of the Drop-in, the following methods of ","type":"text"},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","type":"reference","isActive":true},{"text":" should be implemented:","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"code":["func didComplete(with result: AdyenSessionResult, component: Component, session: AdyenSession)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This method will be invoked when the component finishes without any further steps needed by the application. The application just needs to dismiss the current component, ideally after calling "},{"code":"finalizeIfNeeded","type":"codeVoice"},{"type":"text","text":" on the component."}],"type":"paragraph"},{"type":"thematicBreak"},{"code":["func didFail(with error: Error, from component: Component, session: AdyenSession)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This method is invoked when an error occurred during the use of the Drop-in or the components.","type":"text"},{"text":" ","type":"text"},{"text":"You can then call the ","type":"text"},{"code":"finalizeIfNeeded","type":"codeVoice"},{"text":" on the component, dismiss the component’s view controller in the completion callback and display an error message.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"code":["func didOpenExternalApplication(component: DropInComponent)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This optional method is invoked after a redirect to an external application has occurred."}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"Handling an action","level":2,"anchor":"Handling-an-action","type":"heading"},{"inlineContent":[{"type":"text","text":"Actions are handled by the Drop-in via its delegate "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Receiving redirect","level":3,"anchor":"Receiving-redirect","type":"heading"},{"inlineContent":[{"type":"text","text":"In case the customer is redirected to an external URL or App, make sure to let the "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/RedirectComponent","isActive":true},{"type":"text","text":" know when the user returns to your app. Do this by implementing the following in your "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["func application(_ app: UIApplication, open url: URL, options: [UIApplicationOpenURLOptionsKey: Any] = [:]) -> Bool {","    RedirectComponent.applicationDidOpen(from: url)","    return true","}"],"type":"codeListing","syntax":"swift"}]}],"metadata":{"title":"DropIn","roleHeading":"Article","modules":[{"name":"Adyen"}],"role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/DropIn"},"variants":[{"paths":["\/documentation\/adyen\/dropin"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","sections":[],"references":{"doc://adyen.Adyen/documentation/Adyen/AdyenSessionDelegate":{"url":"\/documentation\/adyen\/adyensessiondelegate","kind":"symbol","title":"AdyenSessionDelegate","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdyenSessionDelegate","kind":"identifier"}],"navigatorTitle":[{"text":"AdyenSessionDelegate","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","abstract":[{"type":"text","text":"Describes the methods a delegate of "},{"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","type":"reference","isActive":true},{"type":"text","text":" needs to implement."}]},"AdvancedFlow.md":{"titleInlineContent":[{"text":"Advanced Flow","type":"text"}],"identifier":"AdvancedFlow.md","type":"link","url":"AdvancedFlow.md","title":"Advanced Flow"},"doc://adyen.Adyen/documentation/Adyen/AdyenSession":{"navigatorTitle":[{"kind":"identifier","text":"AdyenSession"}],"kind":"symbol","abstract":[{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","isActive":true},{"type":"text","text":" acts as the delegate for the checkout payment flow."},{"type":"text","text":" "},{"type":"text","text":"It can handle the required steps internally such as "},{"type":"codeVoice","code":"\/payments"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/payment\/details"},{"type":"text","text":" "},{"type":"text","text":"calls and partial payment calls, then provide feedback"},{"type":"text","text":" "},{"type":"text","text":"via "},{"type":"reference","identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSessionDelegate","isActive":true},{"type":"text","text":" methods."}],"identifier":"doc:\/\/adyen.Adyen\/documentation\/Adyen\/AdyenSession","role":"symbol","url":"\/documentation\/adyen\/adyensession","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdyenSession"}],"title":"AdyenSession","type":"topic"},"doc://adyen.Adyen/documentation/Adyen/DropInComponent":{"abstract":[{"type":"text","text